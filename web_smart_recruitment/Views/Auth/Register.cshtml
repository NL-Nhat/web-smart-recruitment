@using web_smart_recruitment.Models.ViewModels.Auth
@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "_Layout";
    var roles = ViewBag.Roles as List<web_smart_recruitment.Models.VaiTro>;
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        body { margin: 0; background: var(--el-white); }
        .split-screen {
            display: flex;
            height: 100vh;
        }
        .split-left {
            flex: 1;
            background: var(--el-black);
            color: var(--el-white);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
            position: relative;
        }
        .split-right {
            flex: 1.2;
            display: block; /* Thay đổi từ flex sang block để việc cuộn trang ổn định hơn */
            padding: 60px 40px; /* Tăng padding trên để tiêu đề không bị khuất */
            overflow-y: auto;
            background: #fff;
        }
        .reg-box {
            width: 100%;
            max-width: 520px;
            margin: 0 auto; /* Căn giữa box trong container block */
            padding-bottom: 40px;
        }
        .text-danger { color: #dc3545; font-size: 13px; margin-top: 4px; display: block; }
        .hidden { display: none; }
    </style>
}

<div class="split-screen">
    <div class="split-left">
        <div>
            <a class="sr-brand" asp-controller="Home" asp-action="Index" style="font-size: 24px; margin-bottom: 60px; display: inline-block; color: white;">
                <span class="sr-brand-mark" style="background: white; color: black;">SR</span>Smart Recruiter
            </a>
            <h1 class="el-display-hero" style="font-size: 56px; margin-bottom: 24px; color: white;">Khởi đầu hành trình mới.</h1>
            <p style="font-size: 18px; opacity: 0.7; max-width: 400px; line-height: 1.6;">
                Dù bạn là ứng viên tìm kiếm cơ hội hay nhà tuyển dụng tìm kiếm nhân tài, AI của chúng tôi luôn sẵn sàng hỗ trợ.
            </p>
        </div>
    </div>

    <div class="split-right">
        <div class="reg-box">
            <h2 class="el-card-heading" style="margin-bottom: 8px;">Tạo tài khoản mới</h2>
            <p class="el-text-muted" style="margin-bottom: 32px; font-size: 15px;">Vui lòng điền đầy đủ thông tin bên dưới.</p>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="sr-alert sr-alert--error" style="margin-bottom: 20px;"></div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="VaiTro">Bạn là ai?</label>
                    <select class="el-select" asp-for="VaiTro" id="roleSelect" required>
                        <option value="">— Chọn vai trò —</option>
                        @if (roles != null)
                        {
                            foreach (var role in roles)
                            {
                                string displayName = role.TenVaiTro switch
                                {
                                    "UngVien" => "Ứng viên",
                                    "NhaTuyenDung" => "Nhà tuyển dụng",
                                    _ => role.TenVaiTro
                                };
                                <option value="@role.TenVaiTro">@displayName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="VaiTro" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="HoTen">Họ và tên người đại diện</label>
                    <input class="el-input" asp-for="HoTen" placeholder="Nguyễn Văn A" required />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <!-- Phần này chỉ hiện khi chọn Nhà tuyển dụng -->
                <div id="companyField" class="el-form-group hidden">
                    <label class="el-label" asp-for="TenCongTy">Tên công ty / Tổ chức</label>
                    <input class="el-input" asp-for="TenCongTy" placeholder="Công ty TNHH Smart Recruit" />
                    <span asp-validation-for="TenCongTy" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="SoDienThoai">Số điện thoại liên hệ</label>
                    <input class="el-input" asp-for="SoDienThoai" placeholder="0901 234 567" />
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="Email">Email đăng nhập</label>
                    <input class="el-input" type="email" asp-for="Email" placeholder="name@domain.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="Password">Mật khẩu</label>
                    <input class="el-input" type="password" asp-for="Password" placeholder="Tối thiểu 8 ký tự" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <input class="el-input" type="password" asp-for="ConfirmPassword" placeholder="Nhập lại mật khẩu" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="el-btn-primary" style="width: 100%; height: 48px; justify-content: center; margin-top: 12px;">Đăng ký tài khoản</button>
            </form>

            <p style="text-align: center; margin-top: 32px; font-size: 14px; color: var(--el-warm-gray);">
                Đã có tài khoản? <a asp-controller="Auth" asp-action="Login" style="color: var(--el-black); font-weight: 600; text-decoration: none;">Đăng nhập ngay</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @* Script hỗ trợ validation phía Client để người dùng thấy lỗi ngay lập tức *@
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Lắng nghe sự kiện thay đổi vai trò để ẩn/hiện trường "Tên công ty"
        document.getElementById("roleSelect").addEventListener("change", function () {
            var companyField = document.getElementById("companyField");
            // Nếu người dùng là Nhà tuyển dụng, hiển thị thêm thông tin công ty
            if (this.value === "NhaTuyenDung") {
                companyField.classList.remove("hidden");
            } else {
                companyField.classList.add("hidden");
            }
        });

        // Xử lý khi trang được load lại (trường hợp có lỗi validation từ Server gửi về)
        window.addEventListener("DOMContentLoaded", function() {
            var roleSelect = document.getElementById("roleSelect");
            // Duy trì trạng thái hiển thị của trường công ty nếu vai trò đang chọn là Nhà tuyển dụng
            if (roleSelect.value === "NhaTuyenDung") {
                document.getElementById("companyField").classList.remove("hidden");
            }
        });
    </script>
}
