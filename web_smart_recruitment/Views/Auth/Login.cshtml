@using web_smart_recruitment.Models.ViewModels.Auth
@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập người dùng";
    Layout = "_Layout";
    var roles = ViewBag.Roles as List<web_smart_recruitment.Models.VaiTro>;
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        body { margin: 0; background: var(--el-white); }
        .split-screen {
            display: flex;
            height: 100vh;
        }
        .split-left {
            flex: 1.2;
            background: var(--el-warm-stone);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 80px;
            position: relative;
            overflow: hidden;
        }
        .split-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }
        .login-box {
            width: 100%;
            max-width: 400px;
        }
        .decoration-circle {
            position: absolute;
            width: 400px;
            height: 400px;
            background: var(--el-white);
            border-radius: 50%;
            opacity: 0.3;
            top: -100px;
            left: -100px;
        }
        .text-danger { color: #dc3545; font-size: 13px; margin-top: 4px; display: block; }
    </style>
}

<div class="split-screen">
    <div class="split-left">
        <div class="decoration-circle"></div>
        <div style="position: relative; z-index: 1;">
            <a class="sr-brand" asp-controller="Home" asp-action="Index" style="font-size: 24px; margin-bottom: 60px; display: inline-block;">
                <span class="sr-brand-mark">SR</span>Smart Recruiter
            </a>
            <h1 class="el-display-hero" style="font-size: 64px; margin-bottom: 24px;">Tuyển dụng thông minh bằng AI.</h1>
            <p class="el-text-muted" style="font-size: 20px; max-width: 480px; line-height: 1.5;">
                Khám phá quy trình tuyển dụng hiện đại, nơi AI giúp kết nối ứng viên tài năng với những cơ hội phù hợp nhất.
            </p>
        </div>
    </div>

    <div class="split-right">
        <div class="login-box">
            <h2 class="el-card-heading" style="margin-bottom: 8px;">Chào mừng trở lại</h2>
            <p class="el-text-muted" style="margin-bottom: 32px; font-size: 15px;">Vui lòng nhập thông tin để truy cập hệ thống.</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="sr-alert sr-alert--error" style="margin-bottom: 20px;"></div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="VaiTro">Bạn tham gia với vai trò</label>
                    <select class="el-select" asp-for="VaiTro" required>
                        <option value="">— Chọn vai trò —</option>
                        @if (roles != null)
                        {
                            foreach (var role in roles)
                            {
                                // Logic hiển thị tên vai trò có dấu dựa trên mã trong DB
                                string displayName = role.TenVaiTro switch
                                {
                                    "UngVien" => "Ứng viên",
                                    "NhaTuyenDung" => "Nhà tuyển dụng",
                                    _ => role.TenVaiTro
                                };
                                <option value="@role.TenVaiTro">@displayName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="VaiTro" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="Email">Email đăng nhập</label>
                    <input class="el-input" type="email" asp-for="Email" placeholder="name@company.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="el-form-group">
                    <label class="el-label" asp-for="Password">Mật khẩu</label>
                    <input class="el-input" type="password" asp-for="Password" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="el-btn-primary" style="width: 100%; height: 48px; justify-content: center; margin-top: 12px;">Đăng nhập ngay</button>
            </form>

            <p style="text-align: center; margin-top: 32px; font-size: 14px; color: var(--el-warm-gray);">
                Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register" style="color: var(--el-black); font-weight: 600; text-decoration: none;">Đăng ký miễn phí</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
