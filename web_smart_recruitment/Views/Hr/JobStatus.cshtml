@{
    ViewData["Title"] = "Trạng thái tin tuyển dụng";
}

<partial name="_HrNavbar" />

<main class="sr-main" style="max-width: 520px">
    <h1 class="sr-page-title">Trạng thái tin tuyển dụng</h1>
    <p class="sr-page-sub">
        <code>TinTuyenDung.TrangThai</code>: mở nhận CV (<strong>DangMo</strong>), đóng (<strong>DaDong</strong>), hủy
        (<strong>DaHuy</strong>).
    </p>
    <div class="sr-card">
        <div id="msg"></div>
        <p id="job-line" class="sr-text-sm">
            <strong>Senior .NET Developer</strong> — hiện tại: <span class="el-status el-status--success">ĐANG MỞ</span>
        </p>
        <form id="f-st">
            <div class="sr-form-group">
                <label class="sr-label" for="trangThai">Trạng thái mới</label>
                <select class="sr-select" id="trangThai">
                    <option value="DangMo" selected>DangMo — Đang mở nhận CV</option>
                    <option value="DaDong">DaDong — Đã đóng</option>
                    <option value="DaHuy">DaHuy — Đã hủy</option>
                </select>
            </div>
            <button type="submit" class="sr-btn sr-btn--primary">Cập nhật (demo)</button>
            <a class="sr-btn sr-btn--secondary" id="link-ats" href="#">ATS</a>
        </form>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng thay đổi trạng thái tin tuyển dụng hiện đang hiển thị dữ liệu tĩnh.
    </script>
}
