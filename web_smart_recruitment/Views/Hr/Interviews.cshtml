@model IEnumerable<web_smart_recruitment.Models.LichHenPhongVan>
@{
    ViewData["Title"] = "Lịch phỏng vấn";
    string currentViewMode = ViewBag.ViewMode as string ?? "list";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int? selectedJobId = ViewBag.SelectedJobId as int?;
    string selectedStatus = ViewBag.SelectedStatus as string;

    // Helper function to map Status to Vietnamese and CSS class
    (string Text, string CssClass) GetStatusInfo(string status)
    {
        if (string.IsNullOrEmpty(status)) return ("Không rõ", "hr-iv-status--choxacnhan");
        return status switch
        {
            "ChoXacNhan" => ("Chờ xác nhận", "hr-iv-status--choxacnhan"),
            "DaXacNhan" => ("Đã xác nhận", "hr-iv-status--daxacnhan"),
            "DaHuy" => ("Đã hủy", "hr-iv-status--dahuy"),
            "HoanThanh" => ("Hoàn thành", "hr-iv-status--hoanthanh"),
            _ => (status, "hr-iv-status--choxacnhan")
        };
    }
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .interview-card {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }
        .interview-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--el-shadow-lg);
        }
        .interview-card.online { border-left-color: var(--el-primary); }
        .interview-card.offline { border-left-color: #f59e0b; }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }
        .hr-iv-status--choxacnhan { background: #9ca3af; }
        .hr-iv-status--daxacnhan { background: #10b981; }
        .hr-iv-status--dahuy { background: #ef4444; }
        .hr-iv-status--hoanthanh { background: #6366f1; }

        .date-badge {
            background: var(--el-bg-light);
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            min-width: 80px;
        }
        .date-badge .day { font-size: 24px; font-weight: 700; line-height: 1; }
        .date-badge .month { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--el-warm-gray); margin-top: 4px; }

        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: none; place-items: center; z-index: 1000; padding: 20px; }
        .modal-content { background: white; border-radius: 24px; width: 100%; max-width: 550px; padding: 40px; max-height: 90vh; overflow-y: auto; }
        
        .pagination { display: flex; gap: 8px; justify-content: center; margin-top: 40px; }
        .pagination a { padding: 8px 16px; border-radius: 8px; background: var(--el-bg-light); color: var(--el-black); text-decoration: none; font-weight: 600; font-size: 14px; }
        .pagination a.active { background: var(--el-primary); color: white; }
        .pagination a:hover:not(.active) { background: #e5e7eb; }

        .calendar-group-title {
            font-size: 20px; font-weight: 700; margin-top: 32px; margin-bottom: 16px;
            padding-bottom: 8px; border-bottom: 2px solid var(--el-border);
            color: var(--el-primary);
        }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px;">
        <div>
            <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Quản lý Lịch hẹn</h1>
            <p class="el-text-muted">Theo dõi và sắp xếp các buổi phỏng vấn với ứng viên tiềm năng.</p>
        </div>
        <div style="display: flex; gap: 12px;">
            @{
                string toggleView = currentViewMode == "list" ? "calendar" : "list";
                string viewText = currentViewMode == "list" ? "Xem theo lịch" : "Xem dạng danh sách";
            }
            <a href="?viewMode=@toggleView&jobId=@selectedJobId&status=@selectedStatus" class="el-btn-white" style="gap: 8px; text-decoration: none; display: flex; align-items: center;">
                @if (currentViewMode == "list")
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                }
                @viewText
            </a>
        </div>
    </div>

    <form method="get" class="sr-grid" style="grid-template-columns: 1fr 3fr; gap: 32px;">
        <input type="hidden" name="viewMode" value="@currentViewMode" />
        <aside>
            <div class="el-card" style="padding: 24px;">
                <h3 style="margin-top: 0; font-size: 16px; font-weight: 700; margin-bottom: 20px;">Bộ lọc</h3>
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--el-warm-gray); margin-bottom: 8px;">Tin tuyển dụng</label>
                        <select name="jobId" class="el-input" style="width: 100%;" onchange="this.form.submit()">
                            <option value="">Tất cả tin tuyển dụng</option>
                            @if (ViewBag.Jobs != null)
                            {
                                foreach (var job in (IEnumerable<web_smart_recruitment.Models.TinTuyenDung>)ViewBag.Jobs)
                                {
                                    <option value="@job.MaTin" selected="@(selectedJobId == job.MaTin ? "selected" : null)">@job.TieuDe</option>
                                }
                            }
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--el-warm-gray); margin-bottom: 8px;">Trạng thái</label>
                        <select name="status" class="el-input" style="width: 100%;" onchange="this.form.submit()">
                            <option value="">Tất cả trạng thái</option>
                            @if (ViewBag.Statuses != null)
                            {
                                foreach (var st in (IEnumerable<string>)ViewBag.Statuses)
                                {
                                    var stInfo = GetStatusInfo(st);
                                    <option value="@st" selected="@(selectedStatus == st ? "selected" : null)">@stInfo.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div style="margin-top: 16px;">
                        <button type="submit" class="el-btn-primary" style="width: 100%; justify-content: center;">Áp dụng bộ lọc</button>
                    </div>
                </div>
            </div>
        </aside>

        <div id="interview-list" style="display: flex; flex-direction: column; gap: 20px;">
            @if (!Model.Any())
            {
                <div style="padding: 40px; text-align: center; background: var(--el-bg-light); border-radius: 16px;">
                    <h3 style="margin-top: 0;">Chưa có lịch hẹn nào</h3>
                    <p class="el-text-muted">Không tìm thấy lịch hẹn phù hợp với bộ lọc hiện tại.</p>
                </div>
            }
            else
            {
                if (currentViewMode == "calendar")
                {
                    // Chế độ Xem theo lịch: Gom nhóm theo ngày
                    var groupedInterviews = Model.GroupBy(i => i.NgayPhuongVan).OrderBy(g => g.Key);
                    foreach (var group in groupedInterviews)
                    {
                        <div class="calendar-group-title">
                            @group.Key.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
                        </div>
                        foreach (var iv in group)
                        {
                            var statusInfo = GetStatusInfo(iv.TrangThai);
                            string typeClass = (iv.HinhThuc?.ToLower() == "online") ? "online" : "offline";
                            
                            <div class="el-card interview-card @typeClass" style="padding: 24px; display: flex; gap: 24px; align-items: center;">
                                <div class="date-badge">
                                    <div class="day">@iv.NgayPhuongVan.Day</div>
                                    <div class="month">thg @iv.NgayPhuongVan.Month</div>
                                </div>
                                <div style="flex: 1;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                        <div>
                                            <h3 style="margin: 0; font-size: 18px; font-weight: 700;">@iv.MaDonNavigation?.MaUngVienNavigation?.HoTen</h3>
                                            <p style="margin: 4px 0 0; font-size: 14px; color: var(--el-dark-gray);">Vị trí: <strong>@iv.MaDonNavigation?.MaTinNavigation?.TieuDe</strong></p>
                                        </div>
                                    </div>
                                    <div style="margin-top: 16px; display: flex; gap: 24px;">
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--el-warm-gray);">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                            @iv.GioPhuongVan.ToString("HH:mm")
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--el-warm-gray);">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                            @(iv.HinhThuc == "Online" ? "Online: " + iv.LinkHop : "Offline: " + iv.DiaDiem)
                                        </div>
                                    </div>
                                </div>
                                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 25px; min-width: 180px;">
                                    <span style="font-size: 13px; font-weight: 600; display: flex; align-items: center;">
                                        <span class="status-dot @statusInfo.CssClass"></span>
                                        @statusInfo.Text
                                    </span>
                                    <a href="@Url.Action("AiCandidate", "Hr", new { maDon = iv.MaDon })" class="el-btn-primary" style="font-size: 12px; padding: 6px 16px; border-radius: 6px; text-decoration: none;">Xem chi tiết AI</a>
                                </div>
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    @if (iv.TrangThai == "HoanThanh" && iv.MaDonNavigation?.TrangThai != "TrungTuyen" && iv.MaDonNavigation?.TrangThai != "TuChoi")
                                    {
                                        <div style="display: flex; flex-direction: column; gap: 8px;">
                                            <button type="button"
                                                class="el-btn-primary btn-update-app-status"
                                                style="padding: 6px 16px; background: #10b981; border-color: #10b981; font-size: 12px; border-radius: 6px; width: 100px;"
                                                data-madon="@iv.MaDon"
                                                data-newstatus="TrungTuyen"
                                                data-returnurl="@Url.Action("Interviews", "Hr", new { jobId = selectedJobId, status = selectedStatus, viewMode = currentViewMode, page = currentPage })"
                                                title="Đánh giá ứng viên trúng tuyển">Trúng tuyển</button>
                                            <button type="button"
                                                class="el-btn-white btn-update-app-status"
                                                style="padding: 6px 16px; color: #ef4444; border-color: #fca5a5; font-size: 12px; border-radius: 6px; width: 100px;"
                                                data-madon="@iv.MaDon"
                                                data-newstatus="TuChoi"
                                                data-returnurl="@Url.Action("Interviews", "Hr", new { jobId = selectedJobId, status = selectedStatus, viewMode = currentViewMode, page = currentPage })"
                                                title="Từ chối ứng viên">Từ chối</button>
                                        </div>
                                    }

                                    @if (iv.TrangThai == "ChoXacNhan" || iv.TrangThai == "DaXacNhan")
                                    {
                                        <button type="button" class="el-btn-white btn-edit-interview" style="padding: 8px;" title="Chỉnh sửa lịch hẹn"
                                                data-madon="@iv.MaDon"
                                                data-ngay="@iv.NgayPhuongVan.ToString("yyyy-MM-dd")"
                                                data-gio="@iv.GioPhuongVan.ToString("HH:mm")"
                                                data-hinhthuc="@iv.HinhThuc"
                                                data-link="@iv.LinkHop"
                                                data-diadiem="@iv.DiaDiem"
                                                data-ghichu="@iv.GhiChu"
                                                data-trangthai="@iv.TrangThai">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    // Chế độ hiển thị Danh sách thông thường
                    foreach (var iv in Model)
                    {
                        var statusInfo = GetStatusInfo(iv.TrangThai);
                        string typeClass = (iv.HinhThuc?.ToLower() == "online") ? "online" : "offline";
                        
                        <div class="el-card interview-card @typeClass" style="padding: 24px; display: flex; gap: 24px; align-items: center;">
                            <div class="date-badge">
                                <div class="day">@iv.NgayPhuongVan.Day</div>
                                <div class="month">thg @iv.NgayPhuongVan.Month</div>
                            </div>
                            <div style="flex: 1;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div>
                                        <h3 style="margin: 0; font-size: 18px; font-weight: 700;">@iv.MaDonNavigation?.MaUngVienNavigation?.HoTen</h3>
                                        <p style="margin: 4px 0 0; font-size: 14px; color: var(--el-dark-gray);">Vị trí: <strong>@iv.MaDonNavigation?.MaTinNavigation?.TieuDe</strong></p>
                                    </div>
                                </div>
                                <div style="margin-top: 16px; display: flex; gap: 24px;">
                                    <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--el-warm-gray);">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                        @iv.GioPhuongVan.ToString("HH:mm")
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--el-warm-gray);">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                        @(iv.HinhThuc == "Online" ? "Online: " + iv.LinkHop : "Offline: " + iv.DiaDiem)
                                    </div>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 25px; min-width: 180px;">
                                <span style="font-size: 13px; font-weight: 600; display: flex; align-items: center;">
                                    <span class="status-dot @statusInfo.CssClass"></span>
                                    @statusInfo.Text
                                </span>
                                    <a href="@Url.Action("AiCandidate", "Hr", new { maDon = iv.MaDon })" class="el-btn-primary" style="font-size: 12px; padding: 6px 16px; border-radius: 6px; text-decoration: none;">Xem chi tiết AI</a>
                            </div>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                @if (iv.TrangThai == "HoanThanh" && iv.MaDonNavigation?.TrangThai != "TrungTuyen" && iv.MaDonNavigation?.TrangThai != "TuChoi")
                                {
                                    <div style="display: flex; flex-direction: column; gap: 8px;">
                                        <button type="button"
                                            class="el-btn-primary btn-update-app-status"
                                            style="padding: 6px 16px; background: #10b981; border-color: #10b981; font-size: 12px; border-radius: 6px; width: 100px;"
                                            data-madon="@iv.MaDon"
                                            data-newstatus="TrungTuyen"
                                            data-returnurl="@Url.Action("Interviews", "Hr", new { jobId = selectedJobId, status = selectedStatus, viewMode = currentViewMode, page = currentPage })"
                                            title="Đánh giá ứng viên trúng tuyển">Trúng tuyển</button>
                                        <button type="button"
                                            class="el-btn-white btn-update-app-status"
                                            style="padding: 6px 16px; color: #ef4444; border-color: #fca5a5; font-size: 12px; border-radius: 6px; width: 100px;"
                                            data-madon="@iv.MaDon"
                                            data-newstatus="TuChoi"
                                            data-returnurl="@Url.Action("Interviews", "Hr", new { jobId = selectedJobId, status = selectedStatus, viewMode = currentViewMode, page = currentPage })"
                                            title="Từ chối ứng viên">Từ chối</button>
                                    </div>
                                }

                                @if (iv.TrangThai == "ChoXacNhan" || iv.TrangThai == "DaXacNhan")
                                {
                                    <button type="button" class="el-btn-white btn-edit-interview" style="padding: 8px;" title="Chỉnh sửa lịch hẹn"
                                            data-madon="@iv.MaDon"
                                            data-ngay="@iv.NgayPhuongVan.ToString("yyyy-MM-dd")"
                                            data-gio="@iv.GioPhuongVan.ToString("HH:mm")"
                                            data-hinhthuc="@iv.HinhThuc"
                                            data-link="@iv.LinkHop"
                                            data-diadiem="@iv.DiaDiem"
                                            data-ghichu="@iv.GhiChu"
                                            data-trangthai="@iv.TrangThai">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                }

                <!-- Phân trang -->
                @if (totalPages > 1)
                {
                    <div class="pagination">
                        @if (currentPage > 1)
                        {
                            <a href="?page=@(currentPage - 1)&viewMode=@currentViewMode&jobId=@selectedJobId&status=@selectedStatus">Trang trước</a>
                        }
                        
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <a href="?page=@p&viewMode=@currentViewMode&jobId=@selectedJobId&status=@selectedStatus" class="@(p == currentPage ? "active" : "")">@p</a>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a href="?page=@(currentPage + 1)&viewMode=@currentViewMode&jobId=@selectedJobId&status=@selectedStatus">Trang sau</a>
                        }
                    </div>
                }
            }
        </div>
    </form>
</main>

@section Scripts {
    <div class="modal-overlay" id="modal-edit-iv">
        <div class="modal-content">
            <h2 style="font-size: 24px; font-weight: 800; margin-top: 0; margin-bottom: 8px;">Cập nhật lịch hẹn</h2>
            <p class="el-text-muted" style="margin-bottom: 32px;">Chỉnh sửa thông tin lịch hẹn phỏng vấn cho ứng viên.</p>
            
            <form asp-action="UpdateInterview" method="post" id="f-edit-iv">
                <input type="hidden" name="maDon" id="edit-madon" />
                <div class="sr-grid sr-grid--2" style="gap: 16px; margin-bottom: 16px;">
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Ngày phỏng vấn</label>
                        <input type="date" name="NgayPhuongVan" id="edit-ngay" class="el-input" style="width: 100%;" required>
                    </div>
                    <div>
                        <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Giờ phỏng vấn</label>
                        <input type="time" name="GioPhuongVan" id="edit-gio" class="el-input" style="width: 100%;" required>
                    </div>
                </div>
                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Hình thức</label>
                    <select name="HinhThuc" class="el-input" id="edit-hinhthuc" style="width: 100%;" required>
                        @if (ViewBag.HinhThucList != null)
                        {
                            foreach (var ht in (IEnumerable<string>)ViewBag.HinhThucList)
                            {
                                string htVietHoa = ht == "Online" ? "Trực tuyến (Online)" : ht == "Offline" ? "Trực tiếp (Offline)" : ht;
                                <option value="@ht">@htVietHoa</option>
                            }
                        }
                        else
                        {
                            <option value="Online">Trực tuyến (Online)</option>
                            <option value="Offline">Trực tiếp (Offline)</option>
                        }
                    </select>
                </div>
                
                <div style="margin-bottom: 16px;" id="field-trangthai">
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Trạng thái lịch hẹn</label>
                    <select name="TrangThai" class="el-input" id="edit-trangthai" style="width: 100%;">
                        <!-- Options generated by JS -->
                    </select>
                </div>
                
                <div style="margin-bottom: 16px;" id="field-linkhop">
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Link cuộc họp</label>
                    <input type="url" name="LinkHop" id="edit-link" class="el-input" style="width: 100%;" placeholder="https://...">
                </div>

                <div style="margin-bottom: 16px; display: none;" id="field-diadiem">
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Địa điểm phỏng vấn</label>
                    <input type="text" name="DiaDiem" id="edit-diadiem" class="el-input" style="width: 100%;" placeholder="Địa chỉ...">
                </div>

                <div style="margin-bottom: 16px;">
                    <label style="display: block; font-size: 13px; font-weight: 600; margin-bottom: 8px;">Ghi chú thêm</label>
                    <textarea name="GhiChu" id="edit-ghichu" class="el-input" style="width: 100%;" rows="3"></textarea>
                </div>

                <div style="margin-top: 40px; display: flex; gap: 12px; justify-content: flex-end;">
                    <button type="button" class="el-btn-white" id="btn-close-edit-iv">Hủy bỏ</button>
                    <button type="submit" class="el-btn-primary" style="padding: 0 32px;">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("modal-edit-iv");
            const btnClose = document.getElementById("btn-close-edit-iv");
            const editBtns = document.querySelectorAll('.btn-edit-interview');
            
            const hinhThucSelect = document.getElementById("edit-hinhthuc");
            const fieldLinkHop = document.getElementById("field-linkhop");
            const fieldDiaDiem = document.getElementById("field-diadiem");
            const trangThaiSelect = document.getElementById("edit-trangthai");

            function toggleHinhThuc() {
                if (hinhThucSelect.value === "Online") {
                    fieldLinkHop.style.display = "block";
                    fieldDiaDiem.style.display = "none";
                } else {
                    fieldLinkHop.style.display = "none";
                    fieldDiaDiem.style.display = "block";
                }
            }

            function setTrangThaiOptions(currentStatus) {
                trangThaiSelect.innerHTML = "";
                if (currentStatus === "ChoXacNhan") {
                    trangThaiSelect.innerHTML += `<option value="ChoXacNhan">Chờ xác nhận</option>`;
                    trangThaiSelect.innerHTML += `<option value="DaHuy">Đã hủy lịch</option>`;
                } else if (currentStatus === "DaXacNhan") {
                    trangThaiSelect.innerHTML += `<option value="DaXacNhan">Đã xác nhận</option>`;
                    trangThaiSelect.innerHTML += `<option value="HoanThanh">Đã phỏng vấn xong</option>`;
                }
            }

            hinhThucSelect.addEventListener("change", toggleHinhThuc);

            editBtns.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    document.getElementById("edit-madon").value = this.dataset.madon;
                    document.getElementById("edit-ngay").value = this.dataset.ngay;
                    document.getElementById("edit-gio").value = this.dataset.gio;
                    document.getElementById("edit-hinhthuc").value = this.dataset.hinhthuc || "Online";
                    document.getElementById("edit-link").value = this.dataset.link || "";
                    document.getElementById("edit-diadiem").value = this.dataset.diadiem || "";
                    document.getElementById("edit-ghichu").value = this.dataset.ghichu || "";
                    
                    setTrangThaiOptions(this.dataset.trangthai);
                    toggleHinhThuc();
                    modal.style.display = "grid";
                });
            });

            btnClose.addEventListener("click", () => modal.style.display = "none");
            window.addEventListener("click", (e) => {
                if (e.target == modal) modal.style.display = "none";
            });

            // Xử lý nút Trúng tuyển / Từ chối
            // Vì các nút này nằm bên trong form GET (bộ lọc), không thể dùng form POST lồng nhau
            // Giải pháp: tạo form ảo và submit thông qua JavaScript
            document.querySelectorAll(".btn-update-app-status").forEach(btn => {
                btn.addEventListener("click", function () {
                    const maDon = this.dataset.madon;
                    const newStatus = this.dataset.newstatus;
                    const returnUrl = this.dataset.returnurl;

                    // Tạo form ẩn và submit ngoài form bộ lọc để tránh lồng form
                    const form = document.createElement("form");
                    form.method = "POST";
                    form.action = "@Url.Action("UpdateApplicationStatus", "Hr")";

                    const addField = (name, value) => {
                        const input = document.createElement("input");
                        input.type = "hidden";
                        input.name = name;
                        input.value = value;
                        form.appendChild(input);
                    };

                    addField("maDon", maDon);
                    addField("newStatus", newStatus);
                    addField("returnUrl", returnUrl);
                    // Thêm antiforgery token từ cookie nếu có
                    const tokenInput = document.querySelector("input[name='__RequestVerificationToken']");
                    if (tokenInput) addField("__RequestVerificationToken", tokenInput.value);

                    document.body.appendChild(form);
                    form.submit();
                });
            });
        });
    </script>
}
