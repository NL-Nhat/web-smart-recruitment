@{
    ViewData["Title"] = "Lịch phỏng vấn";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .interview-card {
            transition: all 0.3s ease;
            border-left: 4px solid transparent;
        }
        .interview-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--el-shadow-lg);
        }
        .interview-card.online { border-left-color: var(--el-primary); }
        .interview-card.offline { border-left-color: #f59e0b; }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 6px;
        }
        .hr-iv-status--choxacnhan { background: #9ca3af; }
        .hr-iv-status--daxacnhan { background: #10b981; }
        .hr-iv-status--dahuy { background: #ef4444; }
        .hr-iv-status--hoanthanh { background: #6366f1; }

        .date-badge {
            background: var(--el-bg-light);
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            min-width: 80px;
        }
        .date-badge .day { font-size: 24px; font-weight: 700; line-height: 1; }
        .date-badge .month { font-size: 11px; font-weight: 600; text-transform: uppercase; color: var(--el-warm-gray); margin-top: 4px; }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px;">
        <div>
            <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Quản lý Lịch hẹn</h1>
            <p class="el-text-muted">Theo dõi và sắp xếp các buổi phỏng vấn với ứng viên tiềm năng.</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="el-btn-white" style="gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                Xem theo lịch
            </button>
        </div>
    </div>

    <div class="sr-grid" style="grid-template-columns: 1fr 3fr; gap: 32px;">
        <aside>
            <div class="el-card" style="padding: 24px;">
                <h3 style="margin-top: 0; font-size: 16px; font-weight: 700; margin-bottom: 20px;">Bộ lọc</h3>
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--el-warm-gray); margin-bottom: 8px;">Trạng thái</label>
                        <select class="el-input" style="width: 100%;">
                            <option>Tất cả trạng thái</option>
                            <option>Chờ xác nhận</option>
                            <option>Đã xác nhận</option>
                            <option>Hoàn thành</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; color: var(--el-warm-gray); margin-bottom: 8px;">Hình thức</label>
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 14px;">
                                <input type="checkbox" checked /> Online
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; font-size: 14px;">
                                <input type="checkbox" checked /> Offline
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <div id="interview-list" style="display: flex; flex-direction: column; gap: 20px;">
            <!-- Interview cards will be injected here -->
        </div>
    </div>
</main>

@section Scripts {
    <script>
        (function() {
            const s = SR_AUTH.requireAuth("NhaTuyenDung", '@Url.Action("Login", "Auth")');
            if (!s) return;
            SR_AUTH.updateNavPlaceholders();

            const listEl = document.getElementById("interview-list");

            // Filter interviews belonging to this HR's jobs
            const myInterviews = SR_DEMO.lichHenPhongVan.filter(l => {
                const don = SR_DEMO.getDon(l.maDon);
                const tin = don ? SR_DEMO.getTin(don.maTin) : null;
                return tin && tin.maNhaTuyenDung === s.maTaiKhoan;
            }).sort((a, b) => new Date(a.thoiGian) - new Date(b.thoiGian));

            if (myInterviews.length === 0) {
                listEl.innerHTML = '<div class="el-card" style="padding: 60px; text-align: center;"><p class="el-text-muted">Bạn chưa có lịch hẹn phỏng vấn nào.</p></div>';
                return;
            }

            let html = "";
            myInterviews.forEach(l => {
                const don = SR_DEMO.getDon(l.maDon);
                const uv = don ? SR_DEMO.getUngVien(don.maUngVien) : null;
                const tin = don ? SR_DEMO.getTin(don.maTin) : null;
                const dt = new Date(l.thoiGian);

                const day = dt.getDate();
                const month = dt.toLocaleString('vi-VN', { month: 'short' });
                const time = dt.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                let statusLabel = "";
                let statusClass = "";
                switch(l.trangThai) {
                    case "ChoXacNhan": statusLabel = "Chờ xác nhận"; statusClass = "hr-iv-status--choxacnhan"; break;
                    case "DaXacNhan": statusLabel = "Đã xác nhận"; statusClass = "hr-iv-status--daxacnhan"; break;
                    case "DaHuy": statusLabel = "Đã hủy"; statusClass = "hr-iv-status--dahuy"; break;
                    case "HoanThanh": statusLabel = "Hoàn thành"; statusClass = "hr-iv-status--hoanthanh"; break;
                }

                html += `
                    <div class="el-card interview-card ${l.hinhThuc.toLowerCase()}" style="padding: 24px; display: flex; gap: 24px; align-items: center;">
                        <div class="date-badge">
                            <div class="day">${day}</div>
                            <div class="month">${month}</div>
                        </div>
                        <div style="flex: 1;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div>
                                    <h3 style="margin: 0; font-size: 18px; font-weight: 700;">${SR_UI.escapeHtml(uv ? uv.hoTen : 'Ứng viên')}</h3>
                                    <p style="margin: 4px 0 0; font-size: 14px; color: var(--el-dark-gray);">Vị trí: <strong>${SR_UI.escapeHtml(tin ? tin.tieuDe : 'N/A')}</strong></p>
                                </div>
                                <span style="font-size: 13px; font-weight: 600; display: flex; align-items: center;">
                                    <span class="status-dot ${statusClass}"></span>
                                    ${statusLabel}
                                </span>
                            </div>
                            <div style="margin-top: 16px; display: flex; gap: 24px;">
                                <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--el-warm-gray);">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                    ${time}
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--el-warm-gray);">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                    ${l.hinhThuc}: ${SR_UI.escapeHtml(l.diaDiem)}
                                </div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button class="el-btn-white" style="padding: 8px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                            <button class="el-btn-white" style="padding: 8px; color: #ef4444;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg></button>
                        </div>
                    </div>
                `;
            });

            listEl.innerHTML = html;
        })();
    </script>
}
