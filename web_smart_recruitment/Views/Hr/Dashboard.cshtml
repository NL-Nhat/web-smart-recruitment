@{
    ViewData["Title"] = "Bảng điều khiển HR";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .hr-hero-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }
        .stat-card-premium {
            background: var(--el-white);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--el-border-subtle);
            box-shadow: var(--el-shadow-elevation);
            transition: transform 0.2s;
        }
        .stat-card-premium:hover {
            transform: translateY(-4px);
        }
        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            margin-bottom: 16px;
        }
        .activity-item {
            display: flex;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--el-border-subtle);
        }
        .activity-item:last-child {
            border-bottom: none;
        }
        .activity-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--el-bg-light);
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 32px; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1 class="el-display-hero" style="font-size: 36px; margin: 0;">Chào buổi sáng!</h1>
            <p class="el-text-muted">Chào mừng trở lại. Đây là tổng quan về tình hình tuyển dụng của bạn.</p>
        </div>
        <a asp-action="JobForm" class="el-btn-primary" style="height: 48px; padding: 0 24px; font-size: 15px;">+ Đăng tin mới</a>
    </div>

    <div class="hr-hero-stats">
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #E0F2FE; color: #0369A1;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">Tin đang mở</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;" id="stat-jobs">0</div>
        </div>
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #DCFCE7; color: #15803D;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">Tổng ứng viên</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;" id="stat-apps">0</div>
        </div>
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #FEF3C7; color: #B45309;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">Đã tuyển tháng này</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;">12</div>
        </div>
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #F3E8FF; color: #7E22CE;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4"></path><path d="M12 18v4"></path><path d="M4.93 4.93l2.83 2.83"></path><path d="M16.24 16.24l2.83 2.83"></path><path d="M2 12h4"></path><path d="M18 12h4"></path><path d="M4.93 19.07l2.83-2.83"></path><path d="M16.24 7.76l2.83-2.83"></path></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">AI Analysis Score</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;">88.4%</div>
        </div>
    </div>

    <div class="sr-grid" style="grid-template-columns: 1.8fr 1fr; gap: 32px;">
        <div>
            <div class="el-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2 style="font-size: 20px; margin: 0; font-weight: 700;">Tin tuyển dụng gần đây</h2>
                    <a asp-action="Jobs" style="font-size: 14px; font-weight: 600; color: var(--el-black);">Tất cả →</a>
                </div>
                <div id="job-list" style="display: flex; flex-direction: column; gap: 12px;"></div>
            </div>
        </div>

        <div>
            <div class="el-card">
                <h2 style="font-size: 20px; margin: 0 0 24px; font-weight: 700;">Hoạt động gần đây</h2>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
                        <div>
                            <div style="font-size: 14px; font-weight: 600;">Nguyễn Văn A <span style="font-weight: 400; color: var(--el-warm-gray);">vừa nộp đơn vào</span> Senior .NET</div>
                            <div style="font-size: 12px; color: var(--el-warm-gray); margin-top: 2px;">2 phút trước</div>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon" style="color: var(--el-success);"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></div>
                        <div>
                            <div style="font-size: 14px; font-weight: 600;">AI Analysis Hoàn tất</div>
                            <div style="font-size: 14px; color: var(--el-warm-gray);">Vị trí Frontend ReactJS có 5 ứng viên mới đạt > 90%</div>
                            <div style="font-size: 12px; color: var(--el-warm-gray); margin-top: 2px;">15 phút trước</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="el-card" style="background: var(--el-black); color: white; border: none;">
                <h3 style="font-size: 18px; margin: 0 0 12px; font-weight: 700;">Mẹo từ Smart Recruiter</h3>
                <p style="font-size: 14px; opacity: 0.8; line-height: 1.6; margin-bottom: 20px;">
                    Hãy sử dụng tính năng AI Filter để tự động loại bỏ các hồ sơ không phù hợp, giúp bạn tiết kiệm 80% thời gian sàng lọc.
                </p>
                <a href="#" style="color: white; font-weight: 700; font-size: 14px; text-decoration: none;">Tìm hiểu thêm →</a>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        (function() {
            // Xóa bỏ phần kiểm tra auth bằng JS vì đã có Authorize ở Controller
            
            // Dữ liệu demo vẫn giữ lại để hiển thị giao diện cho đẹp
            const myJobs = SR_DEMO.tinTuyenDung.filter(t => t.maNhaTuyenDung === 3); // Lấy tạm ID = 3 cho demo
            const myApps = SR_DEMO.donUngTuyen.filter(d => myJobs.some(j => j.maTin === d.maTin));

            document.getElementById("stat-jobs").textContent = myJobs.filter(j => j.trangThai === "DangMo").length;
            document.getElementById("stat-apps").textContent = myApps.length;

            const listEl = document.getElementById("job-list");
            listEl.innerHTML = myJobs.slice(0, 3).map(j => `
                <div class="el-bordered-item" style="padding: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <div style="font-weight: 600; font-size: 15px;">${SR_UI.escapeHtml(j.tieuDe)}</div>
                            <div style="font-size: 12px; color: var(--el-warm-gray); margin-top: 4px;">
                                Hạn nộp: ${j.hanNopCV} · ${SR_DEMO.donUngTuyen.filter(d => d.maTin === j.maTin).length} ứng viên
                            </div>
                        </div>
                        <div class="el-status el-status--${j.trangThai === 'DangMo' ? 'success' : 'danger'}" style="font-size: 10px;">
                            ${j.trangThai === 'DangMo' ? 'ĐANG MỞ' : 'ĐÃ ĐÓNG'}
                        </div>
                    </div>
                </div>
            `).join("") || '<p class="el-text-muted">Chưa có tin tuyển dụng nào.</p>';
        })();
    </script>
}
