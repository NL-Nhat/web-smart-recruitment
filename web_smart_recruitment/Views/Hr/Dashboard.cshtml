@using web_smart_recruitment.Controllers
@using web_smart_recruitment.Models.Dtos
@{
    ViewData["Title"] = "Bảng điều khiển HR";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .hr-hero-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }
        .stat-card-premium {
            background: var(--el-white);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--el-border-subtle);
            box-shadow: var(--el-shadow-elevation);
            transition: transform 0.2s;
        }
        .stat-card-premium:hover {
            transform: translateY(-4px);
        }
        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            margin-bottom: 16px;
        }
        .activity-item {
            display: flex;
            gap: 16px;
            padding: 16px 0;
            border-bottom: 1px solid var(--el-border-subtle);
        }
        .activity-item:last-child {
            border-bottom: none;
        }
        .activity-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--el-bg-light);
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 32px; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1 class="el-display-hero" style="font-size: 36px; margin: 0;">Chào buổi sáng, @ViewBag.CompanyName!</h1>
            <p class="el-text-muted">Chào mừng trở lại. Đây là tổng quan về tình hình tuyển dụng của bạn.</p>
        </div>
        <a asp-action="JobForm" class="el-btn-primary" style="height: 48px; padding: 0 24px; font-size: 15px; display: flex; align-items: center; justify-content: center; text-decoration: none;">+ Đăng tin mới</a>
    </div>

    <div class="hr-hero-stats">
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #E0F2FE; color: #0369A1;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">Tin đang mở</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;" id="stat-jobs">@ViewBag.ActiveJobsCount</div>
        </div>
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #DCFCE7; color: #15803D;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">Tổng ứng viên</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;" id="stat-apps">@ViewBag.TotalCandidatesCount</div>
        </div>
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #FEF3C7; color: #B45309;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">Đã tuyển tháng này</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;">@ViewBag.HiredThisMonthCount</div>
        </div>
        <div class="stat-card-premium">
            <div class="stat-icon" style="background: #F3E8FF; color: #7E22CE;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4"></path><path d="M12 18v4"></path><path d="M4.93 4.93l2.83 2.83"></path><path d="M16.24 16.24l2.83 2.83"></path><path d="M2 12h4"></path><path d="M18 12h4"></path><path d="M4.93 19.07l2.83-2.83"></path><path d="M16.24 7.76l2.83-2.83"></path></svg>
            </div>
            <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase;">AI Analysis Score</div>
            <div style="font-size: 32px; font-weight: 700; margin-top: 4px;">@(ViewBag.AvgAiScore > 0 ? $"{ViewBag.AvgAiScore:F1}%" : "0.0%")</div>
        </div>
    </div>

    <div class="sr-grid" style="grid-template-columns: 1.8fr 1fr; gap: 32px;">
        <div>
            <div class="el-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2 style="font-size: 20px; margin: 0; font-weight: 700;">Tin tuyển dụng gần đây</h2>
                    <a asp-action="Jobs" style="font-size: 14px; font-weight: 600; color: var(--el-black); text-decoration: none;">Tất cả →</a>
                </div>
                <div id="job-list" style="display: flex; flex-direction: column; gap: 12px;">
                    @if (ViewBag.RecentJobs != null && ((List<web_smart_recruitment.Models.TinTuyenDung>)ViewBag.RecentJobs).Any())
                    {
                        foreach (var job in (List<web_smart_recruitment.Models.TinTuyenDung>)ViewBag.RecentJobs)
                        {
                            <div class="el-bordered-item" style="padding: 16px;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <a href="@Url.Action("Applications", "Hr", new { maTin = job.MaTin })" style="font-weight: 600; font-size: 15px; text-decoration: none; color: var(--el-black); transition: color 0.2s;" onmouseover="this.style.color='var(--el-primary)'" onmouseout="this.style.color='var(--el-black)'">@job.TieuDe</a>
                                        <div style="font-size: 12px; color: var(--el-warm-gray); margin-top: 4px;">
                                            Hạn nộp: @(job.HanNopCv.HasValue ? job.HanNopCv.Value.ToString("dd/MM/yyyy") : "Không thời hạn") · @job.DonUngTuyens.Count ứng viên
                                        </div>
                                    </div>
                                    @if (job.TrangThai == "DangMo")
                                    {
                                        <div class="el-status el-status--success" style="font-size: 10px;">ĐANG MỞ</div>
                                    }
                                    else if (job.TrangThai == "DaDong")
                                    {
                                        <div class="el-status el-status--danger" style="font-size: 10px;">ĐÃ ĐÓNG</div>
                                    }
                                    else if (job.TrangThai == "ChoDuyet")
                                    {
                                        <div class="el-status el-status--warning" style="font-size: 10px;">CHỜ DUYỆT</div>
                                    }
                                    else
                                    {
                                        <div class="el-status" style="font-size: 10px;">@job.TrangThai</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 20px 0; text-align: center; color: var(--el-warm-gray); font-size: 14px;">
                            Bạn chưa có tin tuyển dụng nào. Hãy tạo mới ngay!
                        </div>
                    }
                </div>
            </div>
        </div>

        <div>
            <div class="el-card">
                <h2 style="font-size: 20px; margin: 0 0 24px; font-weight: 700;">Hoạt động gần đây</h2>
                <div class="activity-list">
                    @if (ViewBag.RecentActivities != null && ((List<HrActivityDto>)ViewBag.RecentActivities).Any())
                    {
                        foreach (var act in (List<HrActivityDto>)ViewBag.RecentActivities)
                        {
                            <div class="activity-item">
                                <div class="activity-icon" style="@act.IconColor">@Html.Raw(act.IconHtml)</div>
                                <div>
                                    <div style="font-size: 14px; font-weight: 600;">@act.Title <span style="font-weight: 400; color: var(--el-warm-gray);">@act.Description</span></div>
                                    <div style="font-size: 12px; color: var(--el-warm-gray); margin-top: 2px;">@HrController.GetRelativeTime(act.Time)</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding: 20px 0; text-align: center; color: var(--el-warm-gray); font-size: 14px;">
                            Chưa có hoạt động tuyển dụng nào gần đây.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Bảng điều khiển HR đã được kết nối với dữ liệu từ DB.
    </script>
}
