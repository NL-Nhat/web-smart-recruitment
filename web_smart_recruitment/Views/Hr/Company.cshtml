@{
    ViewData["Title"] = "Thông tin công ty";
}

<partial name="_HrNavbar" />

<main class="sr-main" style="max-width: 560px">
    <h1 class="sr-page-title">Hồ sơ nhà tuyển dụng</h1>
    <p class="sr-page-sub">Bảng <code>NhaTuyenDung</code> — khóa chính = <code>MaTaiKhoan</code>.</p>
    <div class="sr-card">
        <div id="msg"></div>
        <form id="f-co">
            <div class="sr-form-group">
                <label class="sr-label" for="hoTen">Họ tên HR</label>
                <input class="sr-input" id="hoTen" value="Nguyễn HR" required />
            </div>
            <div class="sr-form-group">
                <label class="sr-label" for="tenCongTy">Tên công ty</label>
                <input class="sr-input" id="tenCongTy" value="Công ty Công nghệ ABC" required />
            </div>
            <div class="sr-form-group">
                <label class="sr-label" for="sdt">Số điện thoại liên hệ</label>
                <input class="sr-input" id="sdt" value="0901234567" />
            </div>
            <button type="submit" class="sr-btn sr-btn--primary">Lưu (demo)</button>
        </form>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng hồ sơ nhà tuyển dụng hiện đang hiển thị dữ liệu tĩnh.
    </script>
}
