@{
    ViewData["Title"] = "ATS Dashboard";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .ats-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
            align-items: center;
            padding: 20px 24px;
        }
        .score-box {
            font-size: 20px;
            font-weight: 700;
            color: var(--el-black);
        }
        .score-box.high { color: var(--el-success); }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 3rem;">
        <h1 class="el-display-hero" style="font-size: 40px; margin: 0;" id="title-job">ATS Dashboard</h1>
        <p class="el-text-muted">Danh sách ứng viên được xếp hạng tự động bởi AI dựa trên mức độ phù hợp với JD.</p>
    </div>

    <div class="el-card" style="padding: 16px 24px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <div style="font-size: 14px; font-weight: 600; color: var(--el-warm-gray);">
            SẮP XẾP THEO: <span style="color: var(--el-black);">ĐIỂM AI (GIẢM DẦN)</span>
        </div>
        <div class="el-text-muted" style="font-size: 13px;">
            Đang hiển thị <span id="count-uv" style="font-weight: 600; color: var(--el-black);">0</span> ứng viên
        </div>
    </div>

    <div class="el-bordered">
        <div class="ats-row" style="background: var(--el-bg-light); border-bottom: 1px solid var(--el-border); font-weight: 600; font-size: 13px; color: var(--el-warm-gray);">
            <div>Họ tên ứng viên</div>
            <div>Điểm phù hợp</div>
            <div>Đề xuất AI</div>
            <div>Trạng thái đơn</div>
            <div style="text-align: right;">Hành động</div>
        </div>
        <div id="tb">
            <!-- Dữ liệu mẫu (Static) -->
            <div class="el-bordered-item ats-row">
                <div>
                    <span style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 2px;">Nguyễn Văn A</span>
                    <span class="el-text-muted" style="font-size: 12px;">Nộp ngày: 12/05/2024</span>
                </div>
                <div class="score-box high">92%</div>
                <div><span class="el-status el-status--success" style="background: #D1FAE5;">Tuyển nhanh</span></div>
                <div><span class="el-status el-status--info">Mới nộp</span></div>
                <div style="text-align: right;">
                    <a href='@Url.Action("AiCandidate", "Hr")?maUngVien=1' class="el-btn-primary" style="padding: 6px 16px; font-size: 13px;">Chi tiết AI</a>
                </div>
            </div>
            <div class="el-bordered-item ats-row">
                <div>
                    <span style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 2px;">Trần Thị B</span>
                    <span class="el-text-muted" style="font-size: 12px;">Nộp ngày: 10/05/2024</span>
                </div>
                <div class="score-box">78%</div>
                <div><span class="el-status el-status--warning">Cân nhắc</span></div>
                <div><span class="el-status el-status--warning">AI Đã lọc</span></div>
                <div style="text-align: right;">
                    <a href='@Url.Action("AiCandidate", "Hr")?maUngVien=2' class="el-btn-primary" style="padding: 6px 16px; font-size: 13px;">Chi tiết AI</a>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng ATS Dashboard hiện đang hiển thị dữ liệu tĩnh.
    </script>
}
