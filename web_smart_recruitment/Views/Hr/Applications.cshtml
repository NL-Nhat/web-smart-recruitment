@model IEnumerable<web_smart_recruitment.Models.DonUngTuyen>
@{
    ViewData["Title"] = "ATS Dashboard";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .ats-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
            align-items: center;
            padding: 20px 24px;
        }
        .score-box {
            font-size: 20px;
            font-weight: 700;
            color: var(--el-black);
        }
        .score-box.high { color: var(--el-success); }
        .score-box.medium { color: var(--el-warning); }
        .score-box.low { color: var(--el-danger); }
        .empty-state {
            padding: 40px;
            text-align: center;
            color: var(--el-warm-gray);
        }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 3rem;">
        <h1 class="el-display-hero" style="font-size: 40px; margin: 0;" id="title-job">
            @(ViewBag.JobTitle != null ? $"Ứng viên: {ViewBag.JobTitle}" : "Tất cả ứng viên")
        </h1>
        <p class="el-text-muted">Danh sách ứng viên được xếp hạng tự động bởi AI dựa trên mức độ phù hợp với JD.</p>
    </div>

    <div class="el-card" style="padding: 16px 24px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <div style="font-size: 14px; font-weight: 600; color: var(--el-warm-gray);">
            SẮP XẾP THEO: <span style="color: var(--el-black);">ĐIỂM AI (GIẢM DẦN)</span>
        </div>
        <div class="el-text-muted" style="font-size: 13px;">
            Đang hiển thị <span id="count-uv" style="font-weight: 600; color: var(--el-black);">@(Model?.Count() ?? 0)</span> ứng viên
        </div>
    </div>

    <div class="el-bordered">
        <div class="ats-row" style="background: var(--el-bg-light); border-bottom: 1px solid var(--el-border); font-weight: 600; font-size: 13px; color: var(--el-warm-gray);">
            <div>Họ tên ứng viên</div>
            <div>Điểm phù hợp</div>
            <div>Đề xuất AI</div>
            <div>Trạng thái đơn</div>
            <div style="text-align: right;">Hành động</div>
        </div>
        <div id="tb">
            @if (Model != null && Model.Any())
            {
                // Duyệt qua từng đơn ứng tuyển
                foreach (var application in Model)
                {
                    // Lấy kết quả AI mới nhất của đơn này
                    var latestAiResult = application.KetQuaAis.OrderByDescending(k => k.NgayPhanTich).FirstOrDefault();
                    
                    // Xác định CSS class cho điểm phù hợp
                    string scoreClass = "score-box";
                    if (latestAiResult?.DiemPhuHop >= 80) scoreClass += " high";
                    else if (latestAiResult?.DiemPhuHop >= 50) scoreClass += " medium";
                    else if (latestAiResult?.DiemPhuHop < 50) scoreClass += " low";

                    <div class="el-bordered-item ats-row">
                        <div>
                            <span style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 2px;">
                                @(application.MaUngVienNavigation?.HoTen ?? "Ứng viên ẩn danh")
                            </span>
                            <span class="el-text-muted" style="font-size: 12px;">Nộp ngày: @(application.NgayNop?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                            @if(ViewBag.JobTitle == null)
                            {
                                <span class="el-text-muted" style="font-size: 12px; display: block;">Vị trí: @application.MaTinNavigation?.TieuDe</span>
                            }
                        </div>
                        
                        <div class="@scoreClass">
                            @(latestAiResult?.DiemPhuHop != null ? $"{latestAiResult.DiemPhuHop}%" : "N/A")
                        </div>
                        
                        <div>
                            @* Hiển thị đề xuất của AI *@
                            @if (latestAiResult?.DeXuat == "TuyenNhanh")
                            {
                                <span class="el-status el-status--success" style="background: #D1FAE5;">Tuyển nhanh</span>
                            }
                            else if (latestAiResult?.DeXuat == "CoTheCanNhac")
                            {
                                <span class="el-status el-status--warning">Cân nhắc</span>
                            }
                            else if (latestAiResult?.DeXuat == "LoaiBo")
                            {
                                <span class="el-status el-status--danger">Loại bỏ</span>
                            }
                            else
                            {
                                <span class="el-status">Đang xử lý</span>
                            }
                        </div>
                        
                        <div>
                            @* Hiển thị trạng thái của đơn *@
                            @if (application.TrangThai == "DaNop")
                            {
                                <span class="el-status el-status--info">Mới nộp</span>
                            }
                            else if (application.TrangThai == "DangXuLy")
                            {
                                <span class="el-status el-status--warning">AI Đang lọc</span>
                            }
                            else
                            {
                                <span class="el-status">@application.TrangThai</span>
                            }
                        </div>
                        
                        <div style="text-align: right;">
                            <a href='@Url.Action("AiCandidate", "Hr", new { maDon = application.MaDon })' class="el-btn-primary" style="padding: 6px 16px; font-size: 13px;">Chi tiết AI</a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    Chưa có ứng viên nào nộp đơn vào vị trí này.
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
}
