@{
    ViewData["Title"] = "Quản lý tuyển dụng";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .job-row {
            display: grid;
            grid-template-columns: 2fr 1.5fr 1fr 1fr 1.5fr;
            align-items: center;
            padding: 20px 24px;
        }
        .action-icons {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3rem;">
        <div>
            <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Quản lý tuyển dụng</h1>
            <p class="el-text-muted">Tạo mới và quản trị trạng thái các vị trí đang tuyển dụng tại doanh nghiệp.</p>
        </div>
        <a class="el-btn-primary" asp-action="JobForm" style="height: 48px;">+ Tạo tin tuyển dụng mới</a>
    </div>

    <div class="el-bordered">
        <div class="job-row" style="background: var(--el-bg-light); border-bottom: 1px solid var(--el-border); font-weight: 600; font-size: 13px; color: var(--el-warm-gray);">
            <div>Vị trí tuyển dụng</div>
            <div>Địa điểm</div>
            <div>Trạng thái</div>
            <div>Hạn nộp</div>
            <div style="text-align: right;">Hành động</div>
        </div>
        <div id="job-list"></div>
    </div>
</main>

@section Scripts {
    <script>
        (function() {
            const s = SR_AUTH.requireAuth("NhaTuyenDung", '@Url.Action("Login", "Auth")');
            if (!s) return;
            SR_AUTH.updateNavPlaceholders();

            const listEl = document.getElementById("job-list");
            const jobs = SR_DEMO.tinTuyenDung.filter(t => t.maNhaTuyenDung === s.maTaiKhoan);

            if (jobs.length === 0) {
                listEl.innerHTML = '<div style="padding: 3rem; text-align: center;" class="el-text-muted">Bạn chưa tạo tin tuyển dụng nào.</div>';
                return;
            }

            let html = "";
            jobs.forEach(t => {
                let statusClass = "el-status--success";
                let statusText = "Đang mở";
                if (t.trangThai === "DaDong") { statusClass = "el-status--warning"; statusText = "Đã đóng"; }
                if (t.trangThai === "DaHuy") { statusClass = "el-status--danger"; statusText = "Đã hủy"; }

                html += `
                    <div class="el-bordered-item job-row">
                        <div>
                            <span style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 2px;">${SR_UI.escapeHtml(t.tieuDe)}</span>
                            <span class="el-text-muted" style="font-size: 12px;">ID: #${t.maTin} · ${t.phongBan || 'N/A'}</span>
                        </div>
                        <div class="el-text-warm" style="font-size: 14px;">📍 ${SR_UI.escapeHtml(t.diaDiem)}</div>
                        <div>
                            <span class="el-status ${statusClass}">${statusText}</span>
                        </div>
                        <div class="el-text-muted" style="font-size: 14px;">${t.hanNopCV || '—'}</div>
                        <div class="action-icons">
                            <a href='@Url.Action("Applications", "Hr")?maTin=${t.maTin}' class="el-icon-btn" title="Xem danh sách ứng viên (ATS)">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </a>
                            <a href='@Url.Action("JobForm", "Hr")?maTin=${t.maTin}' class="el-icon-btn" title="Sửa tin">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </a>
                            <button class="el-icon-btn el-icon-btn--danger" title="Xóa tin" onclick="confirm('Xóa tin tuyển dụng này?')">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                        </div>
                    </div>
                `;
            });

            listEl.innerHTML = html;
        })();
    </script>
}
