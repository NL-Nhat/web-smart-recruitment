@{
    ViewData["Title"] = "Phân tích AI Chi tiết";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .ai-score-ring {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: conic-gradient(var(--el-black) var(--score, 0%), #eee 0%);
            display: grid;
            place-items: center;
            position: relative;
        }
        .ai-score-ring::after {
            content: "";
            position: absolute;
            inset: 10px;
            background: white;
            border-radius: 50%;
        }
        .ai-score-inner {
            position: relative;
            z-index: 10;
            text-align: center;
        }
        .analysis-section {
            margin-bottom: 32px;
        }
        .section-header-premium {
            font-size: 18px;
            font-weight: 700;
            color: var(--el-black);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--el-border-subtle);
        }
        .insight-box {
            background: var(--el-bg-light);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--el-border-subtle);
        }
        .strength-list li {
            color: #15803D;
            margin-bottom: 8px;
        }
        .weakness-list li {
            color: #B91C1C;
            margin-bottom: 8px;
        }
        .skill-tag-ai {
            font-size: 13px;
            padding: 6px 14px;
            border-radius: 8px;
            font-weight: 600;
        }
        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
            display: none;
            place-items: center;
            z-index: 1000;
        }
        .modal-container {
            background: white;
            width: 100%;
            max-width: 500px;
            border-radius: 24px;
            padding: 32px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25);
        }
    </style>
}

<partial name="_HrNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 24px;">
        <a href="#" id="back-link" class="el-btn-white" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; font-size: 13px; text-decoration: none; color: var(--el-black);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Quay lại danh sách
        </a>
    </div>
    <div id="content">
        <!-- Dữ liệu mẫu (Static) -->
        <div class="el-card" style="padding: 40px; margin-bottom: 32px; background: var(--el-bg-light); border: none;">
            <div style="display: flex; gap: 48px; align-items: center;">
                <div class="ai-score-ring" style="--score: 92%">
                    <div class="ai-score-inner">
                        <div style="font-size: 36px; font-weight: 700; color: var(--el-black);">92%</div>
                        <div style="font-size: 11px; font-weight: 700; color: var(--el-warm-gray); text-transform: uppercase; letter-spacing: 1px;">Match Score</div>
                    </div>
                </div>
                <div style="flex: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div>
                            <h1 style="font-size: 32px; font-weight: 700; margin: 0;">Nguyễn Văn A</h1>
                            <p style="font-size: 16px; color: var(--el-dark-gray); margin-top: 4px;">Ứng tuyển: <strong>Senior .NET Developer</strong></p>
                        </div>
                        <span class="el-status el-status--success" style="background: #D1FAE5;">Tuyển nhanh</span>
                    </div>
                    <div style="margin-top: 24px; display: flex; gap: 12px;">
                        <a href="#" class="el-btn-primary" style="height: 40px; padding: 0 20px; font-size: 14px;">Xem CV gốc</a>
                        <button class="el-btn-white" style="height: 40px; padding: 0 20px; font-size: 14px;">Tải báo cáo PDF</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="sr-grid" style="grid-template-columns: 2fr 1fr; gap: 32px; align-items: start;">
            <div>
                <section class="analysis-section">
                    <div class="section-header-premium">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
                        Tóm tắt đánh giá của AI
                    </div>
                    <div class="insight-box" style="font-size: 16px; line-height: 1.8; color: var(--el-dark-gray);">
                        Ứng viên có nền tảng kỹ thuật vững chắc với hơn 5 năm kinh nghiệm làm việc với .NET Core và Microservices. Có kỹ năng giải quyết vấn đề tốt và kinh nghiệm dẫn dắt đội ngũ kỹ thuật nhỏ. Rất phù hợp với văn hóa công ty.
                    </div>
                </section>

                <div class="sr-grid sr-grid--2" style="gap: 24px;">
                    <section class="analysis-section">
                        <div class="section-header-premium" style="color: #15803D; border-color: #DCFCE7;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            Điểm mạnh cốt lõi
                        </div>
                        <div class="insight-box" style="background: #F0FDF4; border-color: #DCFCE7;">
                            <ul class="strength-list" style="padding-left: 20px; margin: 0;">
                                <li>Thành thạo ASP.NET Core, Entity Framework</li>
                                <li>Kinh nghiệm triển khai Docker & Kubernetes</li>
                                <li>Tư duy hệ thống và thiết kế Database tốt</li>
                            </ul>
                        </div>
                    </section>

                    <section class="analysis-section">
                        <div class="section-header-premium" style="color: #B91C1C; border-color: #FEE2E2;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            Điểm cần lưu ý
                        </div>
                        <div class="insight-box" style="background: #FEF2F2; border-color: #FEE2E2;">
                            <ul class="weakness-list" style="padding-left: 20px; margin: 0;">
                                <li>Kỹ năng tiếng Anh giao tiếp ở mức trung bình</li>
                                <li>Chưa có nhiều kinh nghiệm với Cloud (AWS/Azure)</li>
                            </ul>
                        </div>
                    </section>
                </div>
            </div>

            <aside>
                <section class="analysis-section">
                    <div class="section-header-premium">Kỹ năng đạt yêu cầu</div>
                    <div class="sr-chips" style="gap: 8px;">
                        <span class="skill-tag-ai" style="background: #DCFCE7; color: #15803D;">.NET Core</span>
                        <span class="skill-tag-ai" style="background: #DCFCE7; color: #15803D;">SQL Server</span>
                        <span class="skill-tag-ai" style="background: #DCFCE7; color: #15803D;">Microservices</span>
                    </div>
                </section>

                <section class="analysis-section" style="margin-top: 32px;">
                    <div class="section-header-premium">Kỹ năng còn thiếu</div>
                    <div class="sr-chips" style="gap: 8px;">
                        <span class="skill-tag-ai" style="background: #FEE2E2; color: #B91C1C;">AWS Lambda</span>
                        <span class="skill-tag-ai" style="background: #FEE2E2; color: #B91C1C;">Terraform</span>
                    </div>
                </section>

                <div class="el-card" style="margin-top: 40px; border: 2px solid var(--el-black);">
                    <h3 style="margin-top: 0; font-size: 18px; font-weight: 700;">Hành động</h3>
                    <p class="el-text-muted" style="font-size: 13px; margin-bottom: 20px;">Cập nhật trạng thái đơn ứng tuyển của ứng viên này.</p>
                    <div id="action-buttons" style="display: flex; flex-direction: column; gap: 10px;">
                        <button class="el-btn-primary" style="background: #15803D; justify-content: center;">Chấp nhận hồ sơ</button>
                        <button class="el-btn-primary" style="background: #B91C1C; justify-content: center;">Từ chối hồ sơ</button>
                        <button class="el-btn-white" style="justify-content: center;" onclick="openModal()">Hẹn lịch phỏng vấn</button>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng phân tích AI hiện đang hiển thị dữ liệu tĩnh.
    </script>
}
