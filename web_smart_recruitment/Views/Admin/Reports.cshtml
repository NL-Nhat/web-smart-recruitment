@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .report-card {
            background: white;
            border-radius: 24px;
            padding: 32px;
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 32px;
        }
        .bar-chart-demo {
            display: flex;
            align-items: flex-end;
            gap: 32px;
            height: 160px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--el-border-subtle);
        }
        .bar-item {
            flex: 1;
            background: var(--el-black);
            border-radius: 4px 4px 0 0;
            position: relative;
        }
        .bar-label {
            position: absolute;
            bottom: -28px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 11px;
            font-weight: 700;
            color: var(--el-warm-gray);
            white-space: nowrap;
        }
    </style>
}

<div class="admin-layout">
    <!-- Sidebar -->
    <partial name="_AdminSidebar" />

    <!-- Main Content -->
    <main class="admin-content">
        <header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px;">
            <div>
                <h1 style="font-size: 32px; font-weight: 800; margin: 0;">Báo cáo & Thống kê</h1>
                <p class="el-text-muted">Phân tích chuyên sâu về dữ liệu tuyển dụng và người dùng trên toàn hệ thống.</p>
            </div>
            <div style="display: flex; gap: 12px;">
                <button class="el-btn-white" style="display: flex; align-items: center; gap: 8px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Xuất file Excel
                </button>
                <button class="el-btn-primary">Tạo báo cáo mới</button>
            </div>
        </header>

        <div class="sr-grid" style="grid-template-columns: 1fr 1fr; gap: 32px;">
            <div class="report-card">
                <h3 style="margin-top: 0; font-size: 18px; font-weight: 700; margin-bottom: 24px;">Lượt ứng tuyển theo tháng</h3>
                <div class="bar-chart-demo">
                    <div class="bar-item" style="height: 40%;"><span class="bar-label">Tháng 1</span></div>
                    <div class="bar-item" style="height: 65%;"><span class="bar-label">Tháng 2</span></div>
                    <div class="bar-item" style="height: 50%;"><span class="bar-label">Tháng 3</span></div>
                    <div class="bar-item" style="height: 85%;"><span class="bar-label">Tháng 4</span></div>
                    <div class="bar-item" style="height: 70%;"><span class="bar-label">Tháng 5</span></div>
                </div>
            </div>
            <div class="report-card">
                <h3 style="margin-top: 0; font-size: 18px; font-weight: 700; margin-bottom: 24px;">Phân bổ vai trò người dùng</h3>
                <div style="display: flex; gap: 24px; align-items: center; height: 160px; justify-content: center;">
                    <div style="width: 140px; height: 140px; border-radius: 50%; background: conic-gradient(var(--el-black) 0% 70%, #94A3B8 70% 95%, #E2E8F0 95% 100%);"></div>
                    <div style="font-size: 13px;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                            <div style="width:12px; height:12px; background:var(--el-black); border-radius:3px;"></div>
                            <span>Ứng viên (70%)</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                            <div style="width:12px; height:12px; background:#94A3B8; border-radius:3px;"></div>
                            <span>Nhà tuyển dụng (25%)</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <div style="width:12px; height:12px; background:#E2E8F0; border-radius:3px;"></div>
                            <span>Admin (5%)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="el-card" style="padding: 0; overflow: hidden;">
            <div style="padding: 24px; border-bottom: 1px solid var(--el-border-subtle);">
                <h3 style="margin: 0; font-size: 18px; font-weight: 700;">Danh sách hoạt động gần nhất</h3>
            </div>
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="background: var(--el-bg-light); border-bottom: 1px solid var(--el-border-subtle);">
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray);">THỜI GIAN</th>
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray);">LOẠI DỮ LIỆU</th>
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray);">NỘI DUNG</th>
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray);">NGƯỜI THỰC HIỆN</th>
                    </tr>
                </thead>
                <tbody style="font-size: 14px;">
                    <tr style="border-bottom: 1px solid var(--el-border-subtle);">
                        <td style="padding: 16px 24px;">22/04/2026 21:05</td>
                        <td style="padding: 16px 24px;"><span class="el-status el-status--info">TIN TUYỂN DỤNG</span></td>
                        <td style="padding: 16px 24px;">Tạo mới tin "Senior AI Engineer"</td>
                        <td style="padding: 16px 24px; font-weight: 600;">FPT Software</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (function() {
            const s = SR_AUTH.requireAuth("Admin", '@Url.Action("Login", "Admin")');
            if (!s) return;

            document.getElementById("admin-logout").onclick = function() {
                SR_AUTH.logout();
                location.href = '@Url.Action("Login", "Admin")';
            };
        })();
    </script>
}
