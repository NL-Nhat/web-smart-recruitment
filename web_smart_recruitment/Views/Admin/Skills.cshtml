@{
    ViewData["Title"] = "Quản lý Kỹ năng";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .skill-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }
        .skill-card {
            background: white;
            padding: 24px;
            border-radius: 20px;
            border: 1px solid rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    </style>
}

<div class="admin-layout">
    <!-- Sidebar -->
    <partial name="_AdminSidebar" />

    <!-- Main Content -->
    <main class="admin-content">
        <header style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px;">
            <div>
                <h1 style="font-size: 32px; font-weight: 800; margin: 0;">Quản lý Kỹ năng</h1>
                <p class="el-text-muted">Danh mục kỹ năng được sử dụng để AI phân tích và chấm điểm hồ sơ.</p>
            </div>
            <button class="el-btn-primary" id="btn-add-skill">+ Thêm kỹ năng mới</button>
        </header>

        <div class="skill-grid" id="skill-list"></div>
    </main>
</div>

@section Scripts {
    <script>
        (function() {
            const s = SR_AUTH.requireAuth("Admin", '@Url.Action("Login", "Admin")');
            if (!s) return;

            document.getElementById("admin-logout").onclick = function() {
                SR_AUTH.logout();
                location.href = '@Url.Action("Login", "Admin")';
            };
            
            const list = document.getElementById("skill-list");
            function render() {
                list.innerHTML = SR_DEMO.danhMucKyNang.map(s => `
                    <div class="skill-card">
                        <div>
                            <div style="font-weight: 700; font-size: 16px;">${SR_UI.escapeHtml(s.tenKyNang)}</div>
                            <div style="font-size: 12px; color: var(--el-warm-gray); margin-top: 4px; font-weight: 600; text-transform: uppercase;">${SR_UI.escapeHtml(s.phanLoai)}</div>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            <button class="el-icon-btn"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></button>
                            <button class="el-icon-btn el-icon-btn--danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                        </div>
                    </div>
                `).join("");
            }
            render();

            document.getElementById("btn-add-skill").onclick = () => {
                const name = prompt("Nhập tên kỹ năng mới:");
                if (name) alert("Đã thêm kỹ năng: " + name);
            };
        })();
    </script>
}
