@{
    ViewData["Title"] = "Hệ thống Quản trị";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
    </style>
}

<div class="admin-layout">
    <!-- Sidebar -->
    <partial name="_AdminSidebar" />

    <!-- Main Content -->
    <main class="admin-content">
        <header class="admin-header">
            <div>
                <h1 style="font-size: 32px; font-weight: 800; margin: 0; color: var(--el-black);">Hệ thống Quản trị</h1>
                <p class="el-text-muted">Chào mừng trở lại, quản trị viên hệ thống. Đây là tóm tắt hoạt động hôm nay.</p>
            </div>
            <div style="display: flex; gap: 12px;">
                <button class="el-btn-white">Cài đặt hệ thống</button>
                <button class="el-btn-primary">Xuất báo cáo tổng hợp</button>
            </div>
        </header>

        <div class="stat-grid-admin">
            <div class="stat-card-admin">
                <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Tổng người dùng</div>
                <div style="font-size: 32px; font-weight: 800; margin-top: 8px;" id="count-users">0</div>
                <div style="font-size: 12px; color: var(--el-success); margin-top: 8px; font-weight: 600;">↑ 12.5% <span style="color: #94A3B8; font-weight: 400;">so với tháng trước</span></div>
            </div>
            <div class="stat-card-admin">
                <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Nhà tuyển dụng</div>
                <div style="font-size: 32px; font-weight: 800; margin-top: 8px;" id="count-hr">0</div>
                <div style="font-size: 12px; color: var(--el-success); margin-top: 8px; font-weight: 600;">+4 <span style="color: #94A3B8; font-weight: 400;">công ty mới tuần này</span></div>
            </div>
            <div class="stat-card-admin">
                <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Tin tuyển dụng</div>
                <div style="font-size: 32px; font-weight: 800; margin-top: 8px;" id="count-jobs">0</div>
                <div style="font-size: 12px; color: var(--el-warning); margin-top: 8px; font-weight: 600;">12 <span style="color: #94A3B8; font-weight: 400;">tin sắp hết hạn</span></div>
            </div>
            <div class="stat-card-admin">
                <div class="el-text-muted" style="font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Lượt ứng tuyển</div>
                <div style="font-size: 32px; font-weight: 800; margin-top: 8px;" id="count-apps">0</div>
                <div style="font-size: 12px; color: var(--el-success); margin-top: 8px; font-weight: 600;">+85 <span style="color: #94A3B8; font-weight: 400;">hồ sơ mới hôm nay</span></div>
            </div>
        </div>

        <div class="el-grid el-grid--2" style="grid-template-columns: 1.6fr 1fr; align-items: stretch;">
            <div class="chart-container">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
                    <h3 style="margin: 0; font-size: 18px; font-weight: 700;">Tăng trưởng người dùng</h3>
                    <select class="el-select" style="width: auto; padding: 6px 12px; font-size: 12px;">
                        <option>7 ngày qua</option>
                        <option>30 ngày qua</option>
                    </select>
                </div>
                <div style="display: flex; align-items: flex-end; justify-content: space-between; height: 240px; padding-bottom: 20px; border-bottom: 1px solid #F1F5F9;">
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 120px; background: #E2E8F0; border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8;">T2</span>
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 160px; background: #E2E8F0; border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8;">T3</span>
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 140px; background: #E2E8F0; border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8;">T4</span>
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 200px; background: var(--el-black); border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8; font-weight: 700; color: black;">T5</span>
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 180px; background: #E2E8F0; border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8;">T6</span>
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 90px; background: #E2E8F0; border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8;">T7</span>
                    </div>
                    <div style="flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 70%; height: 110px; background: #E2E8F0; border-radius: 6px 6px 0 0;"></div>
                        <span style="font-size: 11px; color: #94A3B8;">CN</span>
                    </div>
                </div>
            </div>

            <div class="el-card">
                <h3 style="margin: 0 0 24px 0; font-size: 18px; font-weight: 700;">Hoạt động gần đây</h3>
                <div class="activity-list">
                    <div class="activity-item">
                        <div class="activity-icon" style="background: #ECFDF5; color: #059669;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        </div>
                        <div>
                            <div style="font-size: 14px; font-weight: 600;">Người dùng mới đăng ký</div>
                            <div style="font-size: 12px; color: #94A3B8;">lethanh.ba@gmail.com vừa tạo tài khoản</div>
                            <div style="font-size: 11px; color: #CBD5E1; margin-top: 4px;">2 phút trước</div>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon" style="background: #EFF6FF; color: #2563EB;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline>
                        </div>
                        <div>
                            <div style="font-size: 14px; font-weight: 600;">Tin tuyển dụng mới</div>
                            <div style="font-size: 12px; color: #94A3B8;">FPT Software vừa đăng tin: Senior .NET</div>
                            <div style="font-size: 11px; color: #CBD5E1; margin-top: 4px;">45 phút trước</div>
                        </div>
                    </div>
                    <div class="activity-item">
                        <div class="activity-icon" style="background: #FFF7ED; color: #EA580C;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        </div>
                        <div>
                            <div style="font-size: 14px; font-weight: 600;">Cảnh báo hệ thống</div>
                            <div style="font-size: 12px; color: #94A3B8;">Phát hiện truy cập bất thường từ IP: 1.2.3.4</div>
                            <div style="font-size: 11px; color: #CBD5E1; margin-top: 4px;">2 giờ trước</div>
                        </div>
                    </div>
                </div>
                <button class="el-btn-white" style="width: 100%; margin-top: 24px; font-size: 13px;">Xem tất cả hoạt động</button>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (function() {
            // Dữ liệu demo
            document.getElementById("count-users").textContent = SR_DEMO.taiKhoan.length;
            document.getElementById("count-hr").textContent = SR_DEMO.nhaTuyenDung.length;
            document.getElementById("count-jobs").textContent = SR_DEMO.tinTuyenDung.length;
            document.getElementById("count-apps").textContent = SR_DEMO.donUngTuyen.length;
        })();
    </script>
}
