@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — Smart Recruiter</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        body {
            background: var(--el-bg-light);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }
        .login-container {
            width: 100%;
            max-width: 400px;
            padding: 1rem;
        }
        .admin-badge {
            display: inline-block;
            padding: 4px 12px;
            background: var(--el-black);
            color: white;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-radius: 99px;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <span class="admin-badge">System Administrator</span>
            <h1 class="el-card-heading" style="margin: 0;">Smart Recruiter</h1>
            <p class="el-text-muted" style="font-size: 14px; margin-top: 0.5rem;">Vui lòng đăng nhập để quản trị hệ thống</p>
        </div>

        <div class="el-card">
            <div id="sr-login-alert"></div>
            <form id="form-login" novalidate>
                <div class="sr-form-group">
                    <label class="sr-label" for="email">Email quản trị</label>
                    <input class="sr-input" type="email" id="email" value="admin1@smartrecruit.vn" required />
                </div>
                <div class="sr-form-group">
                    <label class="sr-label" for="password">Mật khẩu</label>
                    <input class="sr-input" type="password" id="password" placeholder="••••••••" required />
                </div>
                <button type="submit" class="sr-btn sr-btn--primary" style="width: 100%; margin-top: 1rem;">
                    Đăng nhập hệ thống
                </button>
            </form>
        </div>

        <p style="text-align: center; margin-top: 2rem; font-size: 13px; color: var(--el-warm-gray);">
            <a asp-controller="Home" asp-action="Index" style="color: inherit; text-decoration: none;">← Quay lại trang chủ</a>
        </p>
    </div>

    <script src="~/js/ui-helpers.js" asp-append-version="true"></script>
    <script src="~/js/demo-data.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script>
        (function () {
            var form = document.getElementById("form-login");
            var alertEl = document.getElementById("sr-login-alert");
            function show(msg, kind) {
                alertEl.innerHTML = '<div class="sr-alert sr-alert--' + (kind || "error") + '">' + SR_UI.escapeHtml(msg) + '</div>';
            }
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                var email = document.getElementById("email").value;
                var password = document.getElementById("password").value;
                var r = SR_AUTH.login(email, password, "Admin");
                if (!r.ok) {
                    show(r.message);
                    return;
                }
                show("Xác thực thành công. Đang chuyển hướng...", "success");
                setTimeout(function () {
                    location.href = '@Url.Action("Dashboard", "Admin")';
                }, 800);
            });
        })();
    </script>
</body>
</html>
