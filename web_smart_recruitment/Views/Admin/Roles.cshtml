@model IEnumerable<web_smart_recruitment.Models.VaiTro>
@{
    ViewData["Title"] = "Quản lý Vai trò";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            place-items: center;
            z-index: 1000;
            padding: 20px;
        }
        .modal-content {
            background: white;
            border-radius: 24px;
            width: 100%;
            max-width: 600px;
            padding: 40px;
            max-height: 90vh;
            overflow-y: auto;
        }
    </style>
}

<div class="admin-layout">
    <partial name="_AdminSidebar" />

    <main class="admin-content">
        <header class="admin-header">
            <div>
                <h1 style="font-size: 32px; font-weight: 800; margin: 0; color: var(--el-black);">Quản lý Vai trò</h1>
                <p class="el-text-muted">Định nghĩa các nhóm quyền hạn và vai trò người dùng trong hệ thống.</p>
            </div>
            <button class="el-btn-primary" id="btn-add-role">+ Thêm vai trò mới</button>
        </header>

        <div class="el-card" style="padding: 0; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="background: #F8FAFC; border-bottom: 1px solid var(--el-border-subtle);">
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray);">TÊN VAI TRÒ</th>
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray);">MÔ TẢ QUYỀN HẠN</th>
                        <th style="padding: 16px 24px; font-size: 12px; font-weight: 700; color: var(--el-warm-gray); width: 120px; text-align: right;">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody id="role-table-body">
                    @foreach (var role in Model)
                    {
                        <tr style="border-bottom: 1px solid var(--el-border-subtle);">
                            <td style="padding: 16px 24px;">
                                <span style="font-weight: 700; color: var(--el-black);">@role.TenVaiTro</span>
                            </td>
                            <td style="padding: 16px 24px; color: var(--el-warm-gray); font-size: 13px;">@(role.MoTa ?? "Chưa có mô tả quyền hạn.")</td>
                            <td style="padding: 16px 24px; text-align: right;">
                                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                    <button class="el-icon-btn btn-edit-role" data-id="@role.MaVaiTro" data-name="@role.TenVaiTro" data-desc="@role.MoTa" title="Sửa">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </button>
                                    <button class="el-icon-btn btn-delete-role" data-id="@role.MaVaiTro" data-name="@role.TenVaiTro" style="border-color: #fee2e2; color: #ef4444;" title="Xóa">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

<!-- Modal Role -->
<div class="modal-overlay" id="modal-role">
    <div class="modal-content">
        <h2 style="font-size: 24px; font-weight: 800; margin-top: 0; margin-bottom: 8px;" id="modal-title">Thêm vai trò mới</h2>
        <p class="el-text-muted" style="margin-bottom: 32px;">Thiết lập tên và mô tả quyền hạn cho vai trò này.</p>
        
        <form id="f-role">
            <input type="hidden" id="role-id" value="">
            <div class="el-form-group">
                <label class="el-label">Tên vai trò</label>
                <input type="text" class="el-input" id="role-name" placeholder="VD: NhaTuyenDung" required>
            </div>
            <div class="el-form-group">
                <label class="el-label">Mô tả quyền hạn</label>
                <textarea class="el-input" id="role-desc" style="height: 100px; padding: 12px;" placeholder="Mô tả ngắn gọn về quyền của vai trò này..."></textarea>
            </div>

            <div style="margin-top: 40px; display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" class="el-btn-white" id="btn-close-role">Hủy bỏ</button>
                <button type="submit" class="el-btn-primary" style="padding: 0 32px;">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const modal = document.getElementById("modal-role");
            const btnAdd = document.getElementById("btn-add-role");
            const btnClose = document.getElementById("btn-close-role");
            const title = document.getElementById("modal-title");
            const roleIdInput = document.getElementById("role-id");

            btnAdd.onclick = () => {
                title.innerText = "Thêm vai trò mới";
                document.getElementById("f-role").reset();
                roleIdInput.value = "";
                modal.style.display = "grid";
            };

            // Gắn sự kiện sửa vai trò
            document.querySelectorAll(".btn-edit-role").forEach(btn => {
                btn.onclick = () => {
                    const id = btn.getAttribute("data-id");
                    const name = btn.getAttribute("data-name");
                    const desc = btn.getAttribute("data-desc");

                    title.innerText = "Chỉnh sửa vai trò";
                    roleIdInput.value = id;
                    document.getElementById("role-name").value = name;
                    document.getElementById("role-desc").value = desc || "";
                    modal.style.display = "grid";
                };
            });

            btnClose.onclick = () => modal.style.display = "none";

            document.getElementById("f-role").onsubmit = async (e) => {
                e.preventDefault();
                
                const id = roleIdInput.value;
                const name = document.getElementById("role-name").value.trim();
                const desc = document.getElementById("role-desc").value.trim();

                const isEdit = id !== "";
                const endpoint = isEdit ? '/Admin/UpdateRole' : '/Admin/AddRole';
                const bodyData = isEdit
                    ? { maVaiTro: parseInt(id), tenVaiTro: name, moTa: desc }
                    : { tenVaiTro: name, moTa: desc };

                try {
                    const response = await fetch(endpoint, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(bodyData)
                    });
                    
                    const result = await response.json();
                    if (result.success) {
                        alert(result.message);
                        modal.style.display = "none";
                        location.reload();
                    } else {
                        alert(result.message || "Đã xảy ra lỗi.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("Lỗi kết nối đến máy chủ.");
                }
            };

            // Gắn sự kiện xóa vai trò
            document.querySelectorAll(".btn-delete-role").forEach(btn => {
                btn.onclick = async () => {
                    const id = btn.getAttribute("data-id");
                    const name = btn.getAttribute("data-name");

                    if (!confirm(`Bạn có chắc chắn muốn xóa vai trò "${name}" không?`)) {
                        return;
                    }

                    try {
                        const response = await fetch('/Admin/DeleteRole', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ maVaiTro: parseInt(id) })
                        });
                        
                        const result = await response.json();
                        if (result.success) {
                            alert(result.message);
                            location.reload();
                        } else {
                            alert(result.message || "Đã xảy ra lỗi khi xóa vai trò.");
                        }
                    } catch (error) {
                        console.error("Error:", error);
                        alert("Lỗi kết nối đến máy chủ.");
                    }
                };
            });

            window.onclick = (e) => {
                if (e.target == modal) modal.style.display = "none";
            };
        })();
    </script>
}
