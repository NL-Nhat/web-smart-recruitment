@{
    ViewData["Title"] = "Hồ sơ Admin";
    Layout = "_AdminLayout";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
    </style>
}

<div class="admin-layout">
    <!-- Sidebar -->
    <partial name="_AdminSidebar" />

    <!-- Main Content -->
    <main class="admin-content">
        <header style="margin-bottom: 40px;">
            <h1 style="font-size: 32px; font-weight: 800; margin: 0;">Hồ sơ Quản trị</h1>
            <p class="el-text-muted">Cập nhật thông tin tài khoản quản trị hệ thống.</p>
        </header>

        <div class="el-card" style="max-width: 800px; padding: 40px;">
            <div id="msg"></div>
            <form id="f-profile">
                <div class="el-grid el-grid--2" style="row-gap: 24px;">
                    <div class="el-form-group">
                        <label class="el-label">Email quản trị</label>
                        <input type="email" class="el-input" id="email" value="admin@smartrecruiter.com" readonly>
                    </div>
                    <div class="el-form-group">
                        <label class="el-label">Họ và tên</label>
                        <input type="text" class="el-input" id="name" value="Quản trị viên hệ thống">
                    </div>
                    <div class="el-form-group">
                        <label class="el-label">Mật khẩu hiện tại</label>
                        <input type="password" class="el-input" placeholder="********">
                    </div>
                    <div class="el-form-group">
                        <label class="el-label">Mật khẩu mới</label>
                        <input type="password" class="el-input" placeholder="Nhập nếu muốn đổi">
                    </div>
                </div>

                <div style="margin-top: 40px; display: flex; justify-content: flex-end; gap: 16px;">
                    <button type="submit" class="el-btn-primary" style="padding: 0 40px; height: 52px; font-size: 16px;">Lưu cập nhật</button>
                </div>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        (function() {
            const s = SR_AUTH.requireAuth("Admin", '@Url.Action("Login", "Admin")');
            if (!s) return;

            document.getElementById("admin-logout").onclick = function() {
                SR_AUTH.logout();
                location.href = '@Url.Action("Login", "Admin")';
            };
            
            document.getElementById("f-profile").onsubmit = (e) => {
                e.preventDefault();
                document.getElementById("msg").innerHTML = '<div class="sr-alert sr-alert--success">Đã cập nhật hồ sơ quản trị thành công!</div>';
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };
        })();
    </script>
}
