@model IEnumerable<web_smart_recruitment.Models.ViewModels.ApplicationsViewModel>
@{
    ViewData["Title"] = "Đơn ứng tuyển của tôi";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .app-item {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            align-items: center;
            padding: 24px;
        }
        .app-item:hover {
            background: #fafafa;
        }
        .status-badge {
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 99px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 3rem;">
        <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Lịch sử ứng tuyển</h1>
        <p class="el-text-muted">Theo dõi trạng thái và kết quả phân tích AI cho các vị trí bạn đã nộp đơn.</p>
    </div>

    <div class="el-bordered">
        <div class="app-item" style="background: var(--el-bg-light); border-bottom: 1px solid var(--el-border); font-weight: 600; font-size: 13px; color: var(--el-warm-gray);">
            <div>Vị trí & Công ty</div>
            <div>Ngày nộp</div>
            <div>Trạng thái</div>
            <div style="text-align: right;">Kết quả AI</div>
        </div>
        <div id="app-list">
            @if (Model == null || !Model.Any())
            {
                <div style="text-align: center; padding: 3rem;" class="el-text-muted">
                    Bạn chưa nộp đơn ứng tuyển nào.
                </div>
            }
            else
            {
                <!-- Dữ liệu mẫu (Static) -->
            <div class="el-bordered-item app-item">
                <div>
                    <a href="#" style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 4px;">Senior Frontend Developer</a>
                    <span class="el-text-muted" style="font-size: 13px;">Công ty Công nghệ ABC</span>
                </div>
                <div class="el-text-warm" style="font-size: 14px;">12/05/2024</div>
                <div>
                    <span class="el-status el-status--info">Mới nộp</span>
                </div>
                <div style="text-align: right;">
                    <span style="font-weight: 700; font-size: 18px; color: var(--el-black)">85%</span>
                </div>
            </div>

            <div class="el-bordered-item app-item">
                <div>
                    <a href="#" style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 4px;">UI/UX Designer</a>
                    <span class="el-text-muted" style="font-size: 13px;">Creative Studio XYZ</span>
                </div>
                <div class="el-text-warm" style="font-size: 14px;">10/05/2024</div>
                <div>
                    <span class="el-status el-status--warning">AI Đã lọc</span>
                </div>
                <div style="text-align: right;">
                    <span style="font-weight: 700; font-size: 18px; color: var(--el-success)">92%</span>
                </div>
            </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng nộp đơn đã được chuyển sang server-side. 
        // Danh sách này hiện đang hiển thị dữ liệu tĩnh và sẽ được cập nhật từ database sau.
    </script>
}
