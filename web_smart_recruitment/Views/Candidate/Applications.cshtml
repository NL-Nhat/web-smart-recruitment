@model IEnumerable<web_smart_recruitment.Models.ViewModels.ApplicationsViewModel>
@{
    ViewData["Title"] = "Đơn ứng tuyển của tôi";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .app-item {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            align-items: center;
            padding: 24px;
        }
        .app-item:hover {
            background: #fafafa;
        }
        .status-badge {
            font-size: 11px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 99px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        @@media (max-width: 768px) {
            .app-item {
                grid-template-columns: 1fr 1fr;
                gap: 16px;
                padding: 16px;
            }
            /* Hide the header on mobile */
            .el-bordered > .app-item:first-child {
                display: none;
            }
            .app-item > div:first-child {
                grid-column: span 2;
            }
            .app-item > div:last-child {
                text-align: left !important;
            }
        }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 3rem;">
        <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Lịch sử ứng tuyển</h1>
        <p class="el-text-muted">Theo dõi trạng thái và kết quả phân tích AI cho các vị trí bạn đã nộp đơn.</p>
    </div>

    <div class="el-bordered">
        <div class="app-item" style="background: var(--el-bg-light); border-bottom: 1px solid var(--el-border); font-weight: 600; font-size: 13px; color: var(--el-warm-gray);">
            <div>Vị trí & Công ty</div>
            <div>Ngày nộp</div>
            <div>Trạng thái</div>
            <div style="text-align: right;">Kết quả AI</div>
        </div>
        <div id="app-list">
            @if (Model == null || !Model.Any())
            {
                <div style="text-align: center; padding: 3rem;" class="el-text-muted">
                    Bạn chưa nộp đơn ứng tuyển nào.
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="el-bordered-item app-item">
                        <div>
                            <a href="/Candidate/JobDetail?maTin=@item.MaTin" style="font-weight: 600; font-size: 16px; display: block; margin-bottom: 4px;">@item.TieuDeCongViec</a>
                            <span class="el-text-muted" style="font-size: 13px;">@item.TenCongTy</span>
                        </div>
                        <div class="el-text-warm" style="font-size: 14px;">@item.NgayNop.ToString("dd/MM/yyyy")</div>
                        <div>
                            @switch (item.TrangThai)
                            {
                                case "DaNop":
                                    <span class="el-status el-status--info">Đã nộp</span>
                                    break;
                                case "AIDaLoc":
                                    <span class="el-status el-status--warning">AI đã lọc</span>
                                    break;
                                case "DaChapNhan":
                                    <span class="el-status el-status--success">Đã duyệt</span>
                                    break;
                                case "PhongVan":
                                    <span class="el-status el-status--info">Phỏng vấn</span>
                                    break;
                                case "TrungTuyen":
                                    <span class="el-status el-status--success">Trúng tuyển</span>
                                    break;
                                case "TuChoi":
                                    <span class="el-status el-status--danger">Từ chối</span>
                                    break;
                                default:
                                    <span class="el-status el-status--info">@item.TrangThai</span>
                                    break;
                            }
                        </div>
                        <div style="text-align: right;">
                            @if (item.TrangThaiAI == "DangXuLy")
                            {
                                <span class="el-text-muted" style="font-size: 13px; font-style: italic;">Đang phân tích...</span>
                            }
                            else if (item.TrangThaiAI == "Loi")
                            {
                                <span style="font-weight: 600; font-size: 14px; color: var(--el-danger)">Lỗi</span>
                            }
                            else if (item.TrangThaiAI == "HoanThanh" && item.DiemPhuHop.HasValue)
                            {
                                var score = item.DiemPhuHop.Value;
                                var color = score >= 80 ? "var(--el-success)" : (score >= 50 ? "var(--el-black)" : "var(--el-warm-gray)");
                                <span style="font-weight: 700; font-size: 18px; color: @color">@score.ToString("N0")%</span>
                            }
                            else
                            {
                                <span class="el-text-muted" style="font-size: 14px;">-</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng nộp đơn đã được chuyển sang server-side. 
        // Danh sách này hiện đang hiển thị dữ liệu tĩnh và sẽ được cập nhật từ database sau.
    </script>
}
