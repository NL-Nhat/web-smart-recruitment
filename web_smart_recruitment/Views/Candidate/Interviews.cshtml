@model IEnumerable<web_smart_recruitment.Models.LichHenPhongVan>
@{
    ViewData["Title"] = "Lịch phỏng vấn của tôi";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .interview-item {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 20px;
            overflow: hidden;
        }
        .interview-item:hover {
            transform: scale(1.01);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .status-pill {
            padding: 6px 12px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .can-iv-status--choxacnhan { background: #F3F4F6; color: #4B5563; }
        .can-iv-status--daxacnhan { background: #D1FAE5; color: #059669; }
        .can-iv-status--dahuy { background: #FEE2E2; color: #DC2626; }
        .can-iv-status--hoanthanh { background: #E0E7FF; color: #4F46E5; }
        
        .company-logo {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: var(--el-bg-light);
            display: grid;
            place-items: center;
            overflow: hidden;
        }
        .company-logo img { width: 100%; height: 100%; object-fit: cover; }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 48px; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Lịch phỏng vấn</h1>
            <p class="el-text-muted">Cập nhật và theo dõi các lời mời phỏng vấn từ nhà tuyển dụng.</p>
        </div>
        <div class="el-card" style="padding: 12px 24px; border: none; background: #EEF2FF; display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">📅</span>
            <div>
                <div style="font-size: 11px; font-weight: 700; color: #4F46E5; text-transform: uppercase;">Tuần này</div>
                <div style="font-size: 14px; font-weight: 600; color: #1E1B4B;" id="stats-text">@ViewBag.InterviewsThisWeek buổi phỏng vấn</div>
            </div>
        </div>
    </div>

    <div id="interview-list" style="display: grid; grid-template-columns: 1fr; gap: 24px;">
        @if (Model == null || !Model.Any())
        {
            <div style="text-align: center; padding: 3rem;" class="el-card el-text-muted">
                Bạn chưa có lịch hẹn phỏng vấn nào.
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var tin = item.MaDonNavigation?.MaTinNavigation;
                var ntd = tin?.MaNhaTuyenDungNavigation;
                
                <div class="el-card interview-item" style="padding: 32px; display: flex; gap: 32px;" data-id="@item.MaLichHen">
                    <div class="company-logo">
                        @if (ntd != null && !string.IsNullOrEmpty(ntd.Logo))
                        {
                            <img src="@ntd.Logo" alt="Logo" />
                        }
                        else
                        {
                            <span style="font-weight: 700; color: var(--el-warm-gray);">@(ntd?.TenCongTy?.Substring(0, 1) ?? "A")</span>
                        }
                    </div>
                    <div style="flex: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                            <div>
                                <h3 style="margin: 0; font-size: 22px; font-weight: 700; color: var(--el-black);">@(ntd?.TenCongTy ?? "Nha tuyen dung")</h3>
                                <p style="margin: 4px 0 0; font-size: 16px; color: var(--el-dark-gray);">Vị trí: <strong>@(tin?.TieuDe ?? "Cong viec")</strong></p>
                            </div>
                            <span class="status-pill can-iv-status--choxacnhan">Chờ bạn xác nhận</span>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; margin-bottom: 24px; background: var(--el-bg-light); padding: 20px; border-radius: 16px;">
                            <div>
                                <div style="font-size: 11px; font-weight: 700; color: var(--el-warm-gray); text-transform: uppercase; margin-bottom: 6px;">Thời gian</div>
                                <div style="font-weight: 600; color: var(--el-black);">Thứ Hai, 20 tháng 5, 2024</div>
                                <div style="font-size: 14px; color: var(--el-dark-gray); margin-top: 2px;">Vào lúc: 09:00</div>
                            </div>
                            <div>
                                <div style="font-size: 11px; font-weight: 700; color: var(--el-warm-gray); text-transform: uppercase; margin-bottom: 6px;">Hình thức & Địa điểm</div>
                                <div style="font-weight: 600; color: var(--el-black);">Online</div>
                                <div style="font-size: 14px; color: var(--el-primary); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <a href="https://meet.google.com/abc-xyz" target="_blank">https://meet.google.com/abc-xyz</a>
                                </div>
                            </div>
                        </div>

                        <div style="font-size: 14px; color: var(--el-dark-gray);">
                            <strong>Ghi chú từ nhà tuyển dụng:</strong> 
                            <span style="font-style: italic;">"Vui lòng chuẩn bị sẵn máy tính và micrô để làm bài test trực tuyến."</span>
                        </div>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 12px; justify-content: center;">
                        <button class="el-btn-primary btn-accept" style="justify-content: center;">Chấp nhận</button>
                        <button class="el-btn-white btn-decline" style="color: var(--el-danger); justify-content: center;">Từ chối</button>
                    </div>
                </div>
            }
        }
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng quản lý lịch phỏng vấn hiện đang hiển thị dữ liệu tĩnh.
    </script>
}
