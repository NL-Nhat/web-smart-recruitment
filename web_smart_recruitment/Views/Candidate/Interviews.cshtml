@{
    ViewData["Title"] = "Lịch phỏng vấn của tôi";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .interview-item {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 20px;
            overflow: hidden;
        }
        .interview-item:hover {
            transform: scale(1.01);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .status-pill {
            padding: 6px 12px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .can-iv-status--choxacnhan { background: #F3F4F6; color: #4B5563; }
        .can-iv-status--daxacnhan { background: #D1FAE5; color: #059669; }
        .can-iv-status--dahuy { background: #FEE2E2; color: #DC2626; }
        .can-iv-status--hoanthanh { background: #E0E7FF; color: #4F46E5; }
        
        .company-logo {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            background: var(--el-bg-light);
            display: grid;
            place-items: center;
            overflow: hidden;
        }
        .company-logo img { width: 100%; height: 100%; object-fit: cover; }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 48px; display: flex; justify-content: space-between; align-items: flex-end;">
        <div>
            <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Lịch phỏng vấn</h1>
            <p class="el-text-muted">Cập nhật và theo dõi các lời mời phỏng vấn từ nhà tuyển dụng.</p>
        </div>
        <div class="el-card" style="padding: 12px 24px; border: none; background: #EEF2FF; display: flex; align-items: center; gap: 12px;">
            <span style="font-size: 24px;">📅</span>
            <div>
                <div style="font-size: 11px; font-weight: 700; color: #4F46E5; text-transform: uppercase;">Tuần này</div>
                <div style="font-size: 14px; font-weight: 600; color: #1E1B4B;" id="stats-text">0 buổi phỏng vấn</div>
            </div>
        </div>
    </div>

    <div id="interview-list" style="display: grid; grid-template-columns: 1fr; gap: 24px;">
        <!-- Interviews will be rendered here -->
    </div>
</main>

@section Scripts {
    <script>
        (function() {
            const s = SR_AUTH.requireAuth("UngVien", '@Url.Action("Login", "Auth")');
            if (!s) return;
            SR_AUTH.updateNavPlaceholders();

            const listEl = document.getElementById("interview-list");
            
            const myInterviews = SR_DEMO.lichHenPhongVan.filter(l => {
                const don = SR_DEMO.getDon(l.maDon);
                return don && don.maUngVien === s.maTaiKhoan;
            }).sort((a, b) => new Date(a.thoiGian) - new Date(b.thoiGian));

            document.getElementById("stats-text").textContent = myInterviews.length + " buổi phỏng vấn";

            if (myInterviews.length === 0) {
                listEl.innerHTML = `
                    <div class="el-card" style="padding: 80px; text-align: center;">
                        <div style="font-size: 48px; margin-bottom: 24px;">🎐</div>
                        <h3 style="margin: 0; font-size: 20px; font-weight: 700;">Hộp thư trống</h3>
                        <p class="el-text-muted" style="margin-top: 8px;">Bạn chưa nhận được lời mời phỏng vấn nào. Hãy tiếp tục tối ưu CV nhé!</p>
                        <a href='@Url.Action("Jobs", "Candidate")' class="el-btn-primary" style="margin-top: 24px;">Tìm việc làm ngay</a>
                    </div>
                `;
                return;
            }

            let html = "";
            myInterviews.forEach(l => {
                const don = SR_DEMO.getDon(l.maDon);
                const tin = don ? SR_DEMO.getTin(don.maTin) : null;
                const ntd = tin ? SR_DEMO.nhaTuyenDung.find(n => n.maNhaTuyenDung === tin.maNhaTuyenDung) : null;
                
                const dt = new Date(l.thoiGian);
                const dateStr = dt.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
                const timeStr = dt.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
                
                let statusLabel = "";
                let statusClass = "";
                switch(l.trangThai) {
                    case "ChoXacNhan": statusLabel = "Chờ bạn xác nhận"; statusClass = "can-iv-status--choxacnhan"; break;
                    case "DaXacNhan": statusLabel = "Đã xác nhận"; statusClass = "can-iv-status--daxacnhan"; break;
                    case "DaHuy": statusLabel = "Đã hủy"; statusClass = "can-iv-status--dahuy"; break;
                    case "HoanThanh": statusLabel = "Đã hoàn thành"; statusClass = "can-iv-status--hoanthanh"; break;
                }

                html += `
                    <div class="el-card interview-item" style="padding: 32px; display: flex; gap: 32px;">
                        <div class="company-logo">
                            ${ntd && ntd.logo ? `<img src="${ntd.logo}" alt="${ntd.tenCongTy}">` : `<span style="font-weight: 700; color: var(--el-warm-gray);">${ntd ? ntd.tenCongTy[0] : '?'}</span>`}
                        </div>
                        <div style="flex: 1;">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                                <div>
                                    <h3 style="margin: 0; font-size: 22px; font-weight: 700; color: var(--el-black);">${SR_UI.escapeHtml(ntd ? ntd.tenCongTy : 'Công ty')}</h3>
                                    <p style="margin: 4px 0 0; font-size: 16px; color: var(--el-dark-gray);">Vị trí: <strong>${SR_UI.escapeHtml(tin ? tin.tieuDe : 'N/A')}</strong></p>
                                </div>
                                <span class="status-pill ${statusClass}">${statusLabel}</span>
                            </div>
                            
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; margin-bottom: 24px; background: var(--el-bg-light); padding: 20px; border-radius: 16px;">
                                <div>
                                    <div style="font-size: 11px; font-weight: 700; color: var(--el-warm-gray); text-transform: uppercase; margin-bottom: 6px;">Thời gian</div>
                                    <div style="font-weight: 600; color: var(--el-black);">${dateStr}</div>
                                    <div style="font-size: 14px; color: var(--el-dark-gray); margin-top: 2px;">Vào lúc: ${timeStr}</div>
                                </div>
                                <div>
                                    <div style="font-size: 11px; font-weight: 700; color: var(--el-warm-gray); text-transform: uppercase; margin-bottom: 6px;">Hình thức & Địa điểm</div>
                                    <div style="font-weight: 600; color: var(--el-black);">${l.hinhThuc}</div>
                                    <div style="font-size: 14px; color: var(--el-primary); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                       ${l.hinhThuc === 'Online' ? `<a href="${l.diaDiem}" target="_blank">${l.diaDiem}</a>` : l.diaDiem}
                                    </div>
                                </div>
                            </div>

                            <div style="font-size: 14px; color: var(--el-dark-gray);">
                                <strong>Ghi chú từ nhà tuyển dụng:</strong> 
                                <span style="font-style: italic;">"${SR_UI.escapeHtml(l.ghiChu)}"</span>
                            </div>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 12px; justify-content: center;">
                            ${l.trangThai === 'ChoXacNhan' ? `
                                <button class="el-btn-primary" style="justify-content: center;">Chấp nhận</button>
                                <button class="el-btn-white" style="color: var(--el-danger); justify-content: center;">Từ chối</button>
                            ` : `
                                <button class="el-btn-white" style="justify-content: center;">Gửi tin nhắn</button>
                            `}
                        </div>
                    </div>
                `;
            });

            listEl.innerHTML = html;
        })();
    </script>
}
