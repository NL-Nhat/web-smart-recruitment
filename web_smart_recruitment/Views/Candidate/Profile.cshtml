@model web_smart_recruitment.Models.UngVien
@{
    ViewData["Title"] = "Hồ sơ năng lực";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .insight-card {
            background: var(--el-white);
            padding: 20px;
            border-radius: 16px;
            margin-bottom: 16px;
            box-shadow: var(--el-shadow-elevation);
            border: 1px solid var(--el-border-subtle);
        }
        .sk-opt:hover {
            background: var(--el-bg-light);
            color: var(--el-black);
        }
        .skill-del:hover {
            opacity: 1 !important;
            color: var(--el-danger);
        }
        /* Custom dynamic alert banner */
        .profile-alert {
            padding: 12px 16px;
            border-radius: 12px;
            font-size: 14px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            animation: fadeIn 0.3s ease;
        }
        .profile-alert--success {
            background-color: var(--el-success-soft);
            color: var(--el-success);
            border: 1px solid rgba(5, 150, 105, 0.2);
        }
        .profile-alert--danger {
            background-color: var(--el-danger-soft);
            color: var(--el-danger);
            border: 1px solid rgba(220, 38, 38, 0.2);
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 3rem;">
        <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Hồ sơ năng lực</h1>
        <p class="el-text-muted">Hoàn thiện thông tin để AI tối ưu hóa khả năng gợi ý công việc phù hợp.</p>
    </div>

    <div class="el-grid el-grid--2">
        <div class="el-card">
            <h2 class="el-card-heading" style="font-size: 24px; margin-top: 0;">Thông tin cá nhân</h2>
            <div id="msg"></div>
            <form id="f-profile">
                <div class="el-form-group">
                    <label class="el-label" for="hoTen">Họ và tên</label>
                    <input class="el-input" id="hoTen" placeholder="Họ và tên" value="@Model.HoTen" required disabled />
                </div>
                <div class="el-grid el-grid--2">
                    <div class="el-form-group">
                        <label class="el-label" for="sdt">Số điện thoại</label>
                        <input class="el-input" id="sdt" placeholder="Chưa cập nhật số điện thoại" value="@Model.SoDienThoai" disabled />
                    </div>
                    <div class="el-form-group">
                        <label class="el-label" for="namKn">Số năm kinh nghiệm</label>
                        <input class="el-input" id="namKn" type="number" min="0" placeholder="0" value="@Model.SoNamKinhNghiem" disabled />
                    </div>
                </div>
                <div class="el-form-group">
                    <label class="el-label" for="linkedin">Link LinkedIn</label>
                    <input class="el-input" id="linkedin" placeholder="linkedin.com/in/..." value="@Model.LinkLinkedIn" disabled />
                </div>
                <div class="el-form-group">
                    <label class="el-label" for="chucDanh">Chức danh hiện tại</label>
                    <input class="el-input" id="chucDanh" placeholder="Software Engineer, Designer..." value="@Model.ChucDanhHienTai" disabled />
                </div>
                
                <div id="action-buttons">
                    <button type="button" id="btn-edit" class="el-btn-primary" style="width: 100%; height: 48px; justify-content: center; margin-top: 1rem;">Chỉnh sửa hồ sơ</button>
                    <div id="edit-actions" style="display: none; gap: 12px; margin-top: 1rem;">
                        <button type="submit" id="btn-save" class="el-btn-primary" style="flex: 1; height: 48px; justify-content: center;">Lưu thay đổi</button>
                        <button type="button" id="btn-cancel" class="el-btn-warm" style="flex: 1; height: 48px; justify-content: center; background: var(--el-danger-soft); color: var(--el-danger);">Hủy</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="el-card" style="background: var(--el-warm-stone); border: none;">
            <h2 class="el-card-heading" style="font-size: 24px; margin-top: 0;">Quản lý kỹ năng</h2>
            
            <div class="insight-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <p style="margin: 0; font-weight: 600; font-size: 14px; color: var(--el-black);">Kỹ năng của tôi</p>
                    <button type="button" class="el-btn-warm" style="padding: 4px 10px; font-size: 11px;" id="btn-add-skill">+ Thêm</button>
                </div>
                <div class="sr-chips" id="my-skills" style="margin-top: 12px;">
                    @foreach (var item in Model.ChiTietKyNangUngViens)
                    {
                        <span class="el-status el-status--success" data-id="@item.MaKyNang" style="font-size: 13px; padding: 6px 14px; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px;">
                            @item.MaKyNangNavigation.TenKyNang
                            <span class="skill-del" style="cursor: pointer; opacity: 0.6; font-size: 16px; line-height: 1;" onclick="removeSkill(@item.MaKyNang)">&times;</span>
                        </span>
                    }
                </div>
            </div>

            <div class="insight-card">
                <p style="margin: 0; font-weight: 600; font-size: 14px; color: var(--el-black);">Gợi ý lộ trình (AI)</p>
                <p style="font-size: 13px; color: var(--el-dark-gray); margin-top: 8px; line-height: 1.5;">
                    Bạn có 85% điểm phù hợp với các vị trí Senior Frontend. 
                    Hãy bổ sung thêm kiến thức về <strong>Next.js</strong> và <strong>Micro-frontends</strong> để tăng khả năng cạnh tranh.
                </p>
            </div>
        </div>
    </div>
</main>

<div id="skill-picker" style="display:none; position:absolute; background:white; border:1px solid var(--el-border); border-radius:12px; box-shadow:var(--el-shadow-elevation); width:280px; z-index:100; padding:12px; margin-top:8px;">
    <input type="text" class="el-input" id="sk-search" placeholder="Tìm kỹ năng..." style="margin-bottom:12px; height:36px; font-size:13px;">
    <div id="sk-list" style="max-height:200px; overflow-y:auto; display:flex; flex-direction:column; gap:4px;"></div>
</div>

@section Scripts {
    <script>
        // Hàm global dùng cho sự kiện onclick của nút xóa kỹ năng được sinh động
        async function removeSkill(skillId) {
            try {
                const response = await fetch("/Candidate/DeleteSkill", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ MaKyNang: skillId })
                });
                
                const result = await response.json();
                if (result.success) {
                    const chip = document.querySelector(`.sr-chips span[data-id="${skillId}"]`);
                    if (chip) chip.remove();
                    showNotification("success", result.message);
                } else {
                    showNotification("danger", result.message);
                }
            } catch (err) {
                showNotification("danger", "Đã xảy ra lỗi khi kết nối máy chủ.");
            }
        }

        function showNotification(type, text) {
            const msgDiv = document.getElementById("msg");
            msgDiv.innerHTML = `
                <div class="profile-alert profile-alert--${type}">
                    <span>${text}</span>
                </div>
            `;
            setTimeout(() => {
                msgDiv.innerHTML = "";
            }, 4000);
        }

        (function() {
            // Cấu hình Chỉnh sửa thông tin cá nhân
            const btnEdit = document.getElementById("btn-edit");
            const btnCancel = document.getElementById("btn-cancel");
            const editActions = document.getElementById("edit-actions");
            const form = document.getElementById("f-profile");
            
            const inputs = [
                document.getElementById("hoTen"),
                document.getElementById("sdt"),
                document.getElementById("namKn"),
                document.getElementById("linkedin"),
                document.getElementById("chucDanh")
            ];

            let originalValues = {};

            btnEdit.onclick = () => {
                // Lưu lại giá trị ban đầu đề phòng Hủy
                inputs.forEach(input => {
                    originalValues[input.id] = input.value;
                    input.disabled = false;
                });
                
                btnEdit.style.display = "none";
                editActions.style.display = "flex";
            };

            btnCancel.onclick = () => {
                // Khôi phục giá trị ban đầu và khóa trường lại
                inputs.forEach(input => {
                    input.value = originalValues[input.id] || "";
                    input.disabled = true;
                });
                
                btnEdit.style.display = "block";
                editActions.style.display = "none";
            };

            form.onsubmit = async (e) => {
                e.preventDefault();
                
                const payload = {
                    HoTen: document.getElementById("hoTen").value,
                    SoDienThoai: document.getElementById("sdt").value,
                    SoNamKinhNghiem: parseInt(document.getElementById("namKn").value) || 0,
                    LinkLinkedIn: document.getElementById("linkedin").value,
                    ChucDanhHienTai: document.getElementById("chucDanh").value
                };

                try {
                    const response = await fetch("/Candidate/UpdateProfile", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(payload)
                    });

                    const data = await response.json();
                    if (data.success) {
                        showNotification("success", data.message);
                        
                        // Cập nhật lại originalValues thành giá trị mới
                        inputs.forEach(input => {
                            input.disabled = true;
                        });
                        
                        btnEdit.style.display = "block";
                        editActions.style.display = "none";
                    } else {
                        showNotification("danger", data.message);
                    }
                } catch (err) {
                    showNotification("danger", "Đã xảy ra lỗi khi lưu thông tin.");
                }
            };

            // Cấu hình Thêm kỹ năng (AI Insights)
            const btnAddSkill = document.getElementById("btn-add-skill");
            const picker = document.getElementById("skill-picker");
            const skList = document.getElementById("sk-list");
            const skSearch = document.getElementById("sk-search");
            
            let allAvailableSkills = [];

            btnAddSkill.onclick = async (e) => {
                e.stopPropagation();
                
                try {
                    const response = await fetch("/Candidate/GetAvailableSkills");
                    const result = await response.json();
                    
                    if (result.success) {
                        allAvailableSkills = result.skills;
                        renderSkillPickerList(allAvailableSkills);
                        
                        const rect = btnAddSkill.getBoundingClientRect();
                        picker.style.top = (rect.bottom + window.scrollY) + "px";
                        picker.style.left = (rect.left + window.scrollX - 240) + "px";
                        picker.style.display = "block";
                        skSearch.value = "";
                        skSearch.focus();
                    } else {
                        showNotification("danger", "Không thể lấy danh sách kỹ năng.");
                    }
                } catch (err) {
                    showNotification("danger", "Không thể kết nối máy chủ.");
                }
            };

            skSearch.oninput = () => {
                const query = skSearch.value.toLowerCase().trim();
                const filtered = allAvailableSkills.filter(s => s.tenKyNang.toLowerCase().includes(query));
                renderSkillPickerList(filtered);
            };

            function renderSkillPickerList(skillsList) {
                if (skillsList.length === 0) {
                    skList.innerHTML = `<div style="padding:8px 12px; font-size:12px; color:var(--el-dark-gray);">Không tìm thấy kỹ năng nào.</div>`;
                    return;
                }

                skList.innerHTML = skillsList.map(s => `
                    <div class="sk-opt" style="padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 13px;" onclick="addSkillToProfile(${s.maKyNang})">
                        ${s.tenKyNang}
                    </div>
                `).join("");
            }

            // Gán hàm addSkillToProfile vào context global/window để thẻ HTML động gọi được
            window.addSkillToProfile = async function(skillId) {
                picker.style.display = "none";
                
                try {
                    const response = await fetch("/Candidate/AddSkill", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ MaKyNang: skillId })
                    });
                    
                    const result = await response.json();
                    if (result.success) {
                        // Thêm chip kỹ năng mới vào giao diện
                        const mySkillsDiv = document.getElementById("my-skills");
                        const newChip = document.createElement("span");
                        newChip.className = "el-status el-status--success";
                        newChip.setAttribute("data-id", result.skillId);
                        newChip.style.cssText = "font-size: 13px; padding: 6px 14px; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px;";
                        newChip.innerHTML = `
                            ${result.skillName}
                            <span class="skill-del" style="cursor: pointer; opacity: 0.6; font-size: 16px; line-height: 1;" onclick="removeSkill(${result.skillId})">&times;</span>
                        `;
                        mySkillsDiv.appendChild(newChip);
                        showNotification("success", result.message);
                    } else {
                        showNotification("danger", result.message);
                    }
                } catch (err) {
                    showNotification("danger", "Đã xảy ra lỗi khi thêm kỹ năng.");
                }
            };

            document.onclick = (e) => {
                if (!picker.contains(e.target) && e.target !== btnAddSkill) {
                    picker.style.display = "none";
                }
            };
        })();
    </script>
}
