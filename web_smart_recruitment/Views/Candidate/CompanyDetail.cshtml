@model web_smart_recruitment.Models.NhaTuyenDung
@{
    ViewData["Title"] = Model?.TenCongTy ?? "Thông tin công ty";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .co-banner {
            height: 240px;
            background: linear-gradient(135deg, var(--el-black) 0%, #333 100%);
            border-radius: 24px;
            margin-bottom: -60px;
            position: relative;
            overflow: hidden;
        }
        .co-banner::after {
            content: "";
            position: absolute;
            inset: 0;
            background: url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1200') center/cover;
            opacity: 0.3;
        }
        .co-header-card {
            background: var(--el-white);
            border-radius: 24px;
            padding: 32px;
            border: 1px solid var(--el-border-subtle);
            position: relative;
            z-index: 10;
            display: flex;
            gap: 32px;
            align-items: flex-end;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        }
        .co-logo-lg {
            width: 140px;
            height: 140px;
            border-radius: 20px;
            background: white;
            border: 4px solid white;
            box-shadow: 0 8px 24px rgba(0,0,0,0.1);
            object-fit: contain;
            padding: 12px;
        }
        .co-info-main {
            flex: 1;
            padding-bottom: 8px;
        }
        .co-nav-tabs {
            display: flex;
            gap: 32px;
            border-bottom: 1px solid var(--el-border-subtle);
            margin: 40px 0 32px;
        }
        .co-tab {
            padding: 12px 0;
            font-weight: 600;
            color: var(--el-warm-gray);
            cursor: pointer;
            position: relative;
            text-decoration: none;
        }
        .co-tab.is-active {
            color: var(--el-black);
        }
        .co-tab.is-active::after {
            content: "";
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--el-black);
        }
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 24px;
            margin-top: 24px;
        }
        .stat-item {
            background: var(--el-bg-light);
            padding: 20px;
            border-radius: 16px;
            border: 1px solid var(--el-border-subtle);
        }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div id="content">
        <!-- Dữ liệu mẫu (Static) -->
        <div class="co-banner"></div>
        <div class="co-header-card">
            <img src="https://via.placeholder.com/140" class="co-logo-lg" alt="Logo">
            <div class="co-info-main">
                <h1 style="font-size: 32px; font-weight: 700; margin: 0; color: var(--el-black);">@Model.TenCongTy</h1>
                <div style="display: flex; gap: 20px; margin-top: 12px; align-items: center; flex-wrap: wrap;">
                    <span class="el-text-muted" style="font-size: 14px; display: flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <a href="@Model.Website" target="_blank" style="color: inherit; text-decoration: none;">@Model.Website.Replace("https://", "").Replace("http://", "")</a>
                        }
                        else
                        {
                            <span>Chưa cập nhật website</span>
                        }
                    </span>
                    <span class="el-text-muted" style="font-size: 14px; display: flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        Tòa nhà Innovation, Quận 1, TP.HCM
                    </span>
                    <span class="el-text-muted" style="font-size: 14px; display: flex; align-items: center; gap: 6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
                        100 - 500 nhân viên
                    </span>
                </div>
            </div>
            <button class="el-btn-primary" style="height: 48px; padding: 0 32px;">Theo dõi</button>
        </div>

        <div class="co-nav-tabs">
            <a href="#" class="co-tab is-active">Tổng quan</a>
            <a href="#jobs" class="co-tab">Việc làm (2)</a>
        </div>

        <div class="sr-grid" style="grid-template-columns: 2fr 1.2fr; gap: 40px; align-items: start;">
            <div>
                <section style="margin-bottom: 48px;">
                    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 20px;">Giới thiệu về công ty</h2>
                    <div style="line-height: 1.8; color: var(--el-dark-gray); font-size: 16px; white-space: pre-line;">
                        @(string.IsNullOrEmpty(Model.MoTa) ? "Thông tin giới thiệu về công ty đang được cập nhật." : Model.MoTa)
                    </div>
                </section>

                <section id="jobs">
                    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 24px;">Vị trí đang tuyển dụng</h2>
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <a href="#" class="el-bordered-item" style="text-decoration: none; color: inherit; display: block; padding: 24px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 600;">Senior Frontend Developer (React)</h3>
                                    <div style="display: flex; gap: 16px; font-size: 14px; color: var(--el-warm-gray);">
                                        <span>📍 Quận 1, TP.HCM</span>
                                        <span>💰 25,000,000 - 45,000,000 VND</span>
                                    </div>
                                </div>
                                <span style="font-weight: 700; font-size: 20px;">→</span>
                            </div>
                        </a>
                        <a href="#" class="el-bordered-item" style="text-decoration: none; color: inherit; display: block; padding: 24px;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 600;">AI Engineer (Computer Vision)</h3>
                                    <div style="display: flex; gap: 16px; font-size: 14px; color: var(--el-warm-gray);">
                                        <span>📍 Quận 1, TP.HCM</span>
                                        <span>💰 Thỏa thuận</span>
                                    </div>
                                </div>
                                <span style="font-weight: 700; font-size: 20px;">→</span>
                            </div>
                        </a>
                    </div>
                </section>
            </div>

            <aside>
                <div class="el-card" style="margin-bottom: 24px;">
                    <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 20px;">Thông tin liên hệ</h3>
                    <div style="display: flex; flex-direction: column; gap: 16px;">
                        <div style="display: flex; gap: 12px;">
                            <div style="width: 32px; height: 32px; border-radius: 8px; background: var(--el-bg-light); display: grid; place-items: center; color: var(--el-black);">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            </div>
                            <div>
                                <div style="font-size: 12px; color: var(--el-warm-gray); font-weight: 600;">ĐIỆN THOẠI</div>
                                <div style="font-size: 14px; font-weight: 600;">028 3824 1234</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="el-card">
                    <h3 style="font-size: 18px; margin-top: 0; margin-bottom: 20px;">Địa điểm làm việc</h3>
                    <p style="font-size: 14px; line-height: 1.5; color: var(--el-dark-gray);">
                        Tòa nhà Innovation, Quận 1, TP.HCM
                    </p>
                </div>
            </aside>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Chức năng xem chi tiết công ty hiện đang hiển thị dữ liệu tĩnh.
    </script>
}
