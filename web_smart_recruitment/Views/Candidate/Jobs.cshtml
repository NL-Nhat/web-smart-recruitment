@model IEnumerable<web_smart_recruitment.Models.TinTuyenDung>
@{
    ViewData["Title"] = "Khám phá cơ hội";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .search-bar {
            background: var(--el-white);
            padding: 24px;
            border-radius: 20px;
            box-shadow: var(--el-shadow-outline), var(--el-shadow-elevation);
            margin-bottom: 3rem;
            display: flex;
            gap: 16px;
            align-items: flex-end;
        }
        .job-card {
            background: var(--el-white);
            border: 1px solid var(--el-border);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s ease;
            text-decoration: none;
            color: inherit;
        }
        .job-card:hover {
            border-color: var(--el-black);
            box-shadow: var(--el-shadow-elevation);
            transform: translateY(-2px);
        }
        .job-tags {
            display: flex;
            gap: 8px;
            margin-top: 12px;
            flex-wrap: wrap;
        }
        .job-tag {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--el-warm-gray);
            background: var(--el-bg-light);
            padding: 2px 8px;
            border-radius: 4px;
        }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 2rem;">
        <h1 class="el-display-hero" style="font-size: 40px; margin: 0;">Khám phá cơ hội</h1>
        <p class="el-text-muted">Tìm kiếm vị trí phù hợp với năng lực và định hướng của bạn qua hệ thống AI.</p>
    </div>

    <form method="get" asp-action="Jobs" class="search-bar">
        <div class="el-form-group" style="flex: 2; margin-bottom: 0;">
            <label class="el-label">Từ khóa</label>
            <input class="el-input" name="q" id="q" type="search" placeholder="Vị trí, kỹ năng, công ty..." value="@Context.Request.Query["q"]" />
        </div>
        <div class="el-form-group" style="flex: 1; margin-bottom: 0;">
            <label class="el-label">Địa điểm</label>
            <select class="el-select" name="loc" id="loc">
                <option value="">Tất cả địa điểm</option>
                <!option value="Hà Nội" @(Context.Request.Query["loc"] == "Hà Nội" ? "selected" : "")>Hà Nội</!option>
                <!option value="TP.HCM" @(Context.Request.Query["loc"] == "TP.HCM" ? "selected" : "")>TP.HCM</!option>
                <!option value="Đà Nẵng" @(Context.Request.Query["loc"] == "Đà Nẵng" ? "selected" : "")>Đà Nẵng</!option>
            </select>
        </div>
        <button type="submit" class="el-btn-primary" style="height: 48px;">Tìm kiếm</button>
    </form>

    <div id="job-list" class="el-grid el-grid--3">
        @if (Model != null && Model.Any())
        {
            foreach (var t in Model)
            {
                <a href='@Url.Action("JobDetail", "Candidate", new { maTin = t.MaTin })' class="job-card">
                    <div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                            <span style="font-size: 13px; font-weight: 600; color: var(--el-warm-gray);">
                                @(t.MaNhaTuyenDungNavigation?.TenCongTy ?? "Công ty ẩn danh")
                            </span>
                            <span class="el-status el-status--info" style="font-size: 10px;">@t.HinhThucLamViec</span>
                        </div>
                        <h3 style="font-size: 18px; margin: 0 0 8px; font-weight: 600;">@t.TieuDe</h3>
                        <p class="el-text-muted" style="font-size: 14px; margin-bottom: 16px;">
                            @(t.MoTaCongViec?.Length > 100 ? t.MoTaCongViec.Substring(0, 100) + "..." : t.MoTaCongViec)
                        </p>
                    </div>
                    <div>
                        <div style="display: flex; gap: 12px; font-size: 13px; margin-bottom: 12px;">
                            <span class="el-text-warm">📍 @t.DiaDiem</span>
                            <span style="font-weight: 600; color: var(--el-black);">
                                @(t.MucLuongToiThieu?.ToString("N0")) - @(t.MucLuongToiDa?.ToString("N0")) VNĐ
                            </span>
                        </div>
                        <div class="job-tags">
                            @foreach (var skill in t.ChiTietKyNangTinTuyenDungs.Take(3))
                            {
                                <span class="job-tag">@skill.MaKyNangNavigation?.TenKyNang</span>
                            }
                            @if (t.ChiTietKyNangTinTuyenDungs.Count > 3)
                            {
                                <span class="job-tag">+@(t.ChiTietKyNangTinTuyenDungs.Count - 3)</span>
                            }
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div style="grid-column: 1/-1; text-align: center; padding: 3rem;">
                <p class="el-text-muted">Không tìm thấy công việc phù hợp.</p>
            </div>
        }
    </div>
</main>
