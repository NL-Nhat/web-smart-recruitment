@model web_smart_recruitment.Models.TinTuyenDung
@{
    ViewData["Title"] = Model?.TieuDe ?? "Chi tiết công việc";
}

@section Styles {
    <style>
        :root { --el-font-display: "Inter", sans-serif; }
        .job-header-card {
            background: var(--el-white);
            border-radius: 24px;
            padding: 40px;
            border: 1px solid var(--el-border-subtle);
            margin-bottom: 24px;
            box-shadow: var(--el-shadow-elevation);
        }
        .key-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 24px;
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid var(--el-border-subtle);
        }
        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
        }
        .info-icon {
            width: 40px;
            height: 40px;
            background: var(--el-bg-light);
            border-radius: 12px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
        }
        .info-label {
            font-size: 12px;
            color: var(--el-warm-gray);
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 2px;
        }
        .info-value {
            font-size: 15px;
            font-weight: 600;
            color: var(--el-black);
        }
        .detail-card {
            background: var(--el-white);
            border-radius: 20px;
            padding: 32px;
            border: 1px solid var(--el-border-subtle);
            margin-bottom: 24px;
        }
        .detail-card h2 {
            font-size: 20px;
            margin-top: 0;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .detail-card h2::before {
            content: "";
            width: 4px;
            height: 20px;
            background: var(--el-black);
            border-radius: 2px;
        }
        .sticky-sidebar-container {
            position: sticky;
            top: 100px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }
        .company-preview-card {
            background: var(--el-bg-light);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--el-border-subtle);
        }
        .co-logo-sm {
            width: 56px;
            height: 56px;
            border-radius: 12px;
            object-fit: contain;
            background: white;
            padding: 4px;
            border: 1px solid var(--el-border-subtle);
        }
    </style>
}

<partial name="_CandidateNavbar" />

<main class="sr-main">
    <div style="margin-bottom: 24px;">
        <a asp-action="Jobs" class="el-btn-white" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; font-size: 13px; text-decoration: none; color: var(--el-black);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Quay lại danh sách
        </a>
    </div>

    @if (Model != null)
    {
        <div class="job-header-card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div style="flex: 1;">
                    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                        <span class="el-status el-status--success" style="font-size: 11px;">@Model.TrangThai</span>
                        <span class="el-text-muted" style="font-size: 13px;">Đăng ngày: @Model.NgayTao?.ToString("dd/MM/yyyy")</span>
                    </div>
                    <h1 style="font-size: 40px; font-weight: 700; margin: 0; color: var(--el-black); line-height: 1.2;">
                        @Model.TieuDe
                    </h1>
                    <p style="font-size: 18px; color: var(--el-dark-gray); margin-top: 8px; font-weight: 500;">
                        @(Model.MaNhaTuyenDungNavigation?.TenCongTy ?? "Công ty ẩn danh")
                    </p>
                </div>
                <img src="@(string.IsNullOrEmpty(Model.MaNhaTuyenDungNavigation?.Logo) ? "https://via.placeholder.com/100" : Model.MaNhaTuyenDungNavigation.Logo)" alt="Logo" style="width: 80px; height: 80px; object-fit: contain; border: 1px solid var(--el-border-subtle); border-radius: 16px; padding: 8px;">
            </div>

            <div class="key-info-grid">
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22m5-18H8.5a4.5 4.5 0 0 0 0 9h7a4.5 4.5 0 0 1 0 9H7"></path></svg>
                    </div>
                    <div>
                        <div class="info-label">Mức lương</div>
                        <div class="info-value" style="color: var(--el-success);">
                            @(Model.MucLuongToiThieu?.ToString("N0")) – @(Model.MucLuongToiDa?.ToString("N0")) VNĐ
                        </div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div>
                        <div class="info-label">Địa điểm</div>
                        <div class="info-value">@Model.DiaDiem</div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    </div>
                    <div>
                        <div class="info-label">Hình thức</div>
                        <div class="info-value">@Model.HinhThucLamViec</div>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <div>
                        <div class="info-label">Hạn nộp</div>
                        <div class="info-value">@Model.HanNopCv?.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="sr-grid" style="grid-template-columns: 2fr 1fr; gap: 32px; align-items: start;">
            <div>
                <div class="detail-card">
                    <h2>Mô tả công việc</h2>
                    <div style="line-height: 1.8; color: var(--el-dark-gray); white-space: pre-line;">@Model.MoTaCongViec</div>
                </div>

                <div class="detail-card">
                    <h2>Yêu cầu ứng viên</h2>
                    <div style="line-height: 1.8; color: var(--el-dark-gray); white-space: pre-line;">@Model.YeuCauCongViec</div>
                </div>

                <div class="detail-card">
                    <h2>Quyền lợi</h2>
                    <div style="line-height: 1.8; color: var(--el-dark-gray); white-space: pre-line;">@(Model.QuyenLoi ?? "Trao đổi trực tiếp khi phỏng vấn.")</div>
                </div>

                <div class="detail-card">
                    <h2>Kỹ năng ưu tiên</h2>
                    <div class="sr-chips" style="gap: 12px; margin-top: 8px;">
                        @if (Model.ChiTietKyNangTinTuyenDungs.Any())
                        {
                            foreach (var skill in Model.ChiTietKyNangTinTuyenDungs)
                            {
                                <span class="el-status el-status--info" style="font-size: 13px; padding: 6px 14px; border-radius: 8px;">
                                    @skill.MaKyNangNavigation?.TenKyNang
                                </span>
                            }
                        }
                        else
                        {
                            <span class="el-text-muted">Liên hệ để biết thêm chi tiết.</span>
                        }
                    </div>
                </div>
            </div>

            <div class="sticky-sidebar-container">
                <div class="detail-card" style="border: 2px solid var(--el-black); margin-bottom: 0;">
                    @if (ViewBag.HasApplied == true)
                    {
                        <h3 style="font-size: 20px; margin-top: 0; margin-bottom: 12px;">Trạng thái ứng tuyển</h3>
                        <div class="sr-alert sr-alert--success" style="margin-bottom: 20px; font-size: 13px;">
                            Bạn đã nộp đơn cho công việc này. Hồ sơ của bạn đang được xử lý.
                        </div>
                        <a asp-action="Applications" class="el-btn-primary" style="width: 100%; height: 52px; justify-content: center; font-size: 16px; text-decoration: none; display: flex; align-items: center;">
                            Xem đơn ứng tuyển
                        </a>
                    }
                    else
                    {
                        <h3 style="font-size: 20px; margin-top: 0; margin-bottom: 12px;">Nộp hồ sơ ngay</h3>
                        <p class="el-text-muted" style="font-size: 14px; line-height: 1.5; margin-bottom: 24px;">
                            Ứng tuyển bằng AI: Hệ thống sẽ tự động phân tích CV của bạn để đánh giá mức độ phù hợp.
                        </p>
                        <div id="apply-msg"></div>
                        <div style="margin-bottom: 20px;">
                            <label class="sr-label" style="margin-bottom: 8px;">Tải lên CV (PDF/DOCX)</label>
                            <input type="file" id="cv-file" accept=".pdf,.doc,.docx" style="font-size: 13px; width: 100%; border: 1px dashed var(--el-border); padding: 12px; border-radius: 8px;" />
                        </div>
                        <button class="el-btn-primary" id="btn-apply" style="width: 100%; height: 52px; justify-content: center; font-size: 16px;">
                            Ứng tuyển ngay
                        </button>
                    }
                </div>

                <div class="company-preview-card">
                    <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 16px;">
                        <img src="@(string.IsNullOrEmpty(Model.MaNhaTuyenDungNavigation?.Logo) ? "https://via.placeholder.com/60" : Model.MaNhaTuyenDungNavigation.Logo)" class="co-logo-sm" alt="Logo">
                        <div style="overflow: hidden;">
                            <h4 style="margin: 0; font-size: 16px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">@(Model.MaNhaTuyenDungNavigation?.TenCongTy ?? "N/A")</h4>
                            <span class="el-text-muted" style="font-size: 13px;">@(Model.MaNhaTuyenDungNavigation?.SoDienThoai ?? "N/A")</span>
                        </div>
                    </div>
                    <p class="el-text-muted" style="font-size: 13px; line-height: 1.6; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                        @(Model.MaNhaTuyenDungNavigation?.DiaChi ?? "Địa chỉ đang cập nhật...")
                    </p>
                    <a href='@Url.Action("CompanyDetail", "Candidate", new { maNhaTuyenDung = Model.MaNhaTuyenDung })' style="display: block; text-align: center; font-size: 14px; font-weight: 700; text-decoration: none; color: var(--el-black); padding: 12px; border: 1px solid var(--el-black); border-radius: 12px;">
                        Xem trang công ty
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="sr-alert sr-alert--error">Không tìm thấy tin tuyển dụng.</div>
    }
</main>

@section Scripts {
    <script>
            // Kiểm tra trạng thái đăng nhập từ Server bằng Razor
            const isLogged = @(User.Identity.IsAuthenticated ? "true" : "false");
            const userRole = "@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")";

            // Xử lý sự kiện khi nhấn nút Ứng tuyển
            const applyBtn = document.getElementById("btn-apply");
            if (applyBtn) {
                applyBtn.addEventListener("click", function () {
                    const msg = document.getElementById("apply-msg");
                    const fileInput = document.getElementById("cv-file");
                    const file = fileInput.files[0];

                    // 1. Kiểm tra đăng nhập và vai trò trực tiếp từ phía client
                    if (!isLogged || userRole !== "UngVien") {
                        msg.innerHTML = '<div class="sr-alert sr-alert--info" style="font-size: 13px;">Vui lòng <a href="@Url.Action("Login", "Auth")" style="font-weight: 700;">đăng nhập</a> với tài khoản Ứng viên để nộp đơn.</div>';
                        return;
                    }
                    
                    // 2. Kiểm tra xem người dùng đã chọn file chưa
                    if (!file) {
                        msg.innerHTML = '<div class="sr-alert sr-alert--error" style="font-size: 13px;">Vui lòng chọn file CV của bạn trước khi ứng tuyển.</div>';
                        return;
                    }

                    // 3. Chuẩn bị dữ liệu gửi lên Server (Mã tin và File)
                    const formData = new FormData();
                    formData.append("maTin", "@Model.MaTin");
                    formData.append("cvFile", file);

                    // 4. Hiển thị trạng thái đang xử lý trên nút
                    const btn = this;
                    btn.disabled = true;
                    btn.style.opacity = "0.5";
                    const originalText = btn.innerText;
                    btn.innerText = "Đang gửi hồ sơ...";

                    // 5. Gửi yêu cầu đến Server bằng Fetch API
                    fetch('@Url.Action("Apply", "Candidate")', {
                        method: 'POST',
                        body: formData
                    })
                    .then(async response => {
                        // Nếu Server trả về lỗi chưa đăng nhập hoặc không có quyền (401/403)
                        if (response.status === 401 || response.status === 403) {
                            throw new Error("Phiên đăng nhập đã hết hạn hoặc bạn không có quyền thực hiện.");
                        }
                        if (!response.ok) {
                            throw new Error("Lỗi hệ thống khi gửi đơn ứng tuyển.");
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // Nộp đơn thành công: Hiển thị thông báo và khóa nút
                            msg.innerHTML = `<div class="sr-alert sr-alert--success" style="font-size: 13px;"><b>Thành công!</b> ${data.message}</div>`;
                            fileInput.value = ""; // Reset input file
                            btn.innerText = "Đã nộp đơn";
                            // Tải lại trang để cập nhật giao diện "Xem đơn ứng tuyển" sau khi nộp thành công
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            // Server trả về lỗi logic
                            msg.innerHTML = `<div class="sr-alert sr-alert--error" style="font-size: 13px;">${data.message}</div>`;
                            resetButton(btn, originalText);
                        }
                    })
                    .catch(error => {
                        // Xử lý các lỗi mạng hoặc lỗi throw ở trên
                        console.error("Apply Error:", error);
                        msg.innerHTML = `<div class="sr-alert sr-alert--error" style="font-size: 13px;">${error.message || "Có lỗi xảy ra, vui lòng thử lại sau."}</div>`;
                        resetButton(btn, originalText);
                    });
                });
            }

            // Hàm reset lại trạng thái nút bấm khi có lỗi
            function resetButton(btn, text) {
                btn.disabled = false;
                btn.style.opacity = "1";
                btn.innerText = text;
            }
    </script>
}
